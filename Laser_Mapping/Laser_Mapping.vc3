089-f7d64e3a653b", "type": "point", "selected": false, "x": 1015, "y": 772.0069427490234}, {"id": "3de1a2ed-f631-47c2-aa51-31a502c38e13", "type": "point", "selected": false, "x": 135, "y": 768.0069427490234}, {"id": "b008de44-cc4b-4803-89c3-d05b1d6f7031", "type": "point", "selected": false, "x": 133, "y": 671.0069427490234}, {"id": "d9fa257e-1144-4b40-b49f-048c38a129e7", "type": "point", "selected": true, "x": 156.0503544807434, "y": 668.3160252571106}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "35437500-4d81-47a6-b36d-4717f06e75c0", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"5edcac28-18c0-420d-acf1-3f3397dbf5ee": {"id": "5edcac28-18c0-420d-acf1-3f3397dbf5ee", "type": "basic.code", "selected": false, "x": 53, "y": 35, "ports": [{"id": "85c60481-dca0-4970-aeb4-a2595a85a957", "type": "port.output", "x": 340.546875, "y": 149.14930725097656, "name": "front_distance", "alignment": "right", "parentNode": "5edcac28-18c0-420d-acf1-3f3397dbf5ee", "links": ["d6e4bb20-ca60-49a2-a026-e7d4dd62c8dc"], "in": false, "label": "front_distance", "hideLabel": false}, {"id": "4123848b-4734-451e-8d1a-b2d3c84476cd", "type": "port.output", "x": 340.546875, "y": 232.25694274902344, "name": "laser_ready", "alignment": "right", "parentNode": "5edcac28-18c0-420d-acf1-3f3397dbf5ee", "links": ["c80606b4-f6cc-47fe-901f-83d927deb7c7"], "in": false, "label": "laser_ready", "hideLabel": false}], "data": {"code": "import math\nimport rclpy\n\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserReader(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_reader\")\n\n            self.front_distance = 10.0\n            self.laser_ready = False\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            values = []\n\n            for index, distance in enumerate(msg.ranges):\n                angle = msg.angle_min + index * msg.angle_increment\n\n                if -0.35 <= angle <= 0.35:\n                    if math.isfinite(distance) and distance > 0.05:\n                        values.append(distance)\n\n            self.front_distance = min(values) if values else 10.0\n            self.laser_ready = True\n\n    node = LaserReader()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n\n        outputs.share_number(\"front_distance\", node.front_distance)\n        outputs.share_number(\"laser_ready\", 1.0 if node.laser_ready else 0.0)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "front_distance"}, {"name": "laser_ready"}]}, "size": {"width": "404px", "height": "300px"}}}, "bc999beb-55be-4f5b-ab1a-13eb99501de1": {"id": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "type": "basic.code", "selected": true, "x": 398, "y": 29, "ports": [{"id": "b1fcade2-44aa-4857-88ca-28cb6ecd2448", "type": "port.input", "x": 399.1111145019531, "y": 145.6979217529297, "name": "front_distance", "alignment": "left", "parentNode": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "links": ["d6e4bb20-ca60-49a2-a026-e7d4dd62c8dc"], "in": true, "label": "front_distance", "hideLabel": false}, {"id": "be42cfc1-8e0b-44b7-95c1-e6db42fbd7e1", "type": "port.input", "x": 399.1111145019531, "y": 230.81077575683594, "name": "laser_ready", "alignment": "left", "parentNode": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "links": ["c80606b4-f6cc-47fe-901f-83d927deb7c7"], "in": true, "label": "laser_ready", "hideLabel": false}, {"id": "dd7c1e99-ca18-4182-920d-737216268b2e", "type": "port.output", "x": 721.107666015625, "y": 188.25869750976562, "name": "state_code", "alignment": "right", "parentNode": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "links": ["84358f67-5570-43a8-b787-f03b9944c5bd"], "in": false, "label": "state_code", "hideLabel": false}], "data": {"code": "import random\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n    TURN_RIGHT = 2.0\n    UTURN_LEFT = 3.0\n    UTURN_RIGHT = 4.0\n    STOP = 5.0\n\n    state = STOP\n\n    stop_distance = 0.60\n    clear_distance = 0.90\n\n    turn_ticks = 0\n\n    normal_turn_ticks = 40\n    uturn_ticks = 80\n\n    while True:\n        distance_wire = inputs.read_number(\"front_distance\")\n        ready_wire = inputs.read_number(\"laser_ready\")\n\n        laser_ready = ready_wire is not None and float(ready_wire[0]) > 0.5\n\n        if not laser_ready or distance_wire is None:\n            state = STOP\n            turn_ticks = 0\n\n        else:\n            front_distance = float(distance_wire[0])\n\n            if state == STOP:\n                state = FORWARD\n\n            if state == FORWARD:\n                if front_distance < stop_distance:\n                    choice = random.choice([\n                        TURN_LEFT,\n                        TURN_RIGHT,\n                        TURN_LEFT,\n                        TURN_RIGHT,\n                        UTURN_LEFT,\n                        UTURN_RIGHT,\n                    ])\n\n                    state = choice\n\n                    if state in [UTURN_LEFT, UTURN_RIGHT]:\n                        turn_ticks = uturn_ticks\n                    else:\n                        turn_ticks = normal_turn_ticks\n\n            elif state in [TURN_LEFT, TURN_RIGHT, UTURN_LEFT, UTURN_RIGHT]:\n                turn_ticks -= 1\n\n                if turn_ticks <= 0 and front_distance > clear_distance:\n                    state = FORWARD\n\n                elif turn_ticks <= -30:\n                    state = FORWARD\n\n        outputs.share_number(\"state_code\", state)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}, {"name": "laser_ready"}], "out": [{"name": "state_code"}]}, "size": {"width": "404px", "height": "300px"}}}, "3ae87f13-e8a3-4cdd-ba7e-3edd16906178": {"id": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "type": "basic.code", "selected": false, "x": 677, "y": 386, "ports": [{"id": "2bbd905e-25a7-4528-a045-99f9ffefe6e6", "type": "port.input", "x": 677.5521240234375, "y": 556.7014007568359, "name": "state_code", "alignment": "left", "parentNode": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "links": ["84358f67-5570-43a8-b787-f03b9944c5bd"], "in": true, "label": "state_code", "hideLabel": false}, {"id": "7528dc27-b377-48af-8ca5-b1ccd40d8617", "type": "port.output", "x": 992.6302490234375, "y": 517.9253997802734, "name": "linear_x", "alignment": "right", "parentNode": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "links": ["652cf184-4df2-4875-9adb-72a8012ec81b"], "in": false, "label": "linear_x", "hideLabel": false}, {"id": "6cab0dd1-c312-45a2-8100-ec620f4bbeef", "type": "port.output", "x": 992.6302490234375, "y": 607.1441497802734, "name": "angular_z", "alignment": "right", "parentNode": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "links": ["1b5e2683-1a14-40ea-a682-67fec8299001"], "in": false, "label": "angular_z", "hideLabel": false}], "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n    TURN_RIGHT = 2.0\n    UTURN_LEFT = 3.0\n    UTURN_RIGHT = 4.0\n\n    forward_speed = 0.70\n    turn_speed = 1.25\n\n    while True:\n        state_wire = inputs.read_number(\"state_code\")\n\n        linear_x = 0.0\n        angular_z = 0.0\n\n        if state_wire is not None:\n            state = float(state_wire[0])\n\n            if state == FORWARD:\n                linear_x = forward_speed\n                angular_z = 0.0\n\n            elif state == TURN_LEFT:\n                linear_x = 0.0\n                angular_z = turn_speed\n\n            elif state == TURN_RIGHT:\n                linear_x = 0.0\n                angular_z = -turn_speed\n\n            elif state == UTURN_LEFT:\n                linear_x = 0.0\n                angular_z = turn_speed\n\n            elif state == UTURN_RIGHT:\n                linear_x = 0.0\n                angular_z = -turn_speed\n\n        outputs.share_number(\"linear_x\", linear_x)\n        outputs.share_number(\"angular_z\", angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "state_code"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}]}, "size": {"width": "300px", "height": "300px"}}}, "2843ebc0-0a57-470a-a397-3615a752123e": {"id": "2843ebc0-0a57-470a-a397-3615a752123e", "type": "basic.code", "selected": false, "x": 148, "y": 387, "ports": [{"id": "72261b8a-c1e5-48a6-9e6d-0f7ce3e13a5f", "type": "port.input", "x": 148.55035400390625, "y": 545.2604217529297, "name": "linear_x", "alignment": "left", "parentNode": "2843ebc0-0a57-470a-a397-3615a752123e", "links": ["652cf184-4df2-4875-9adb-72a8012ec81b"], "in": true, "label": "linear_x", "hideLabel": false}, {"id": "1a42b2f8-e5a5-44ba-b0cc-8e16f6daf5e4", "type": "port.input", "x": 148.55035400390625, "y": 660.8160247802734, "name": "angular_z", "alignment": "left", "parentNode": "2843ebc0-0a57-470a-a397-3615a752123e", "links": ["1b5e2683-1a14-40ea-a682-67fec8299001"], "in": true, "label": "angular_z", "hideLabel": false}], "data": {"code": "import rclpy\n\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class VelocityPublisher(Node):\n        def __init__(self):\n            super().__init__(\"vc_velocity_publisher\")\n\n            self.publisher = self.create_publisher(\n                Twist,\n                \"/turtlebot3/cmd_vel\",\n                10,\n            )\n\n        def send_velocity(self, linear_x, angular_z):\n            command = Twist()\n            command.linear.x = float(linear_x)\n            command.angular.z = float(angular_z)\n            self.publisher.publish(command)\n\n    node = VelocityPublisher()\n\n    while True:\n        linear_wire = inputs.read_number(\"linear_x\")\n        angular_wire = inputs.read_number(\"angular_z\")\n\n        linear_x = float(linear_wire[0]) if linear_wire is not None else 0.0\n        angular_z = float(angular_wire[0]) if angular_wire is not None else 0.0\n\n        node.send_velocity(linear_x, angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}], "out": []}, "size": {"width": "404px", "height": "318px"}}}}}]}, "version": "3.0", "package": {"name": "Laser_Mapping", "version": "", "description": "", "author": "", "image": "", "category": "", "tags": []}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "5edcac28-18c0-420d-acf1-3f3397dbf5ee", "type": "basic.code", "data": {"code": "import math\nimport rclpy\n\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserReader(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_reader\")\n\n            self.front_distance = 10.0\n            self.laser_ready = False\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            values = []\n\n            for index, distance in enumerate(msg.ranges):\n                angle = msg.angle_min + index * msg.angle_increment\n\n                if -0.35 <= angle <= 0.35:\n                    if math.isfinite(distance) and distance > 0.05:\n                        values.append(distance)\n\n            self.front_distance = min(values) if values else 10.0\n            self.laser_ready = True\n\n    node = LaserReader()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n\n        outputs.share_number(\"front_distance\", node.front_distance)\n        outputs.share_number(\"laser_ready\", 1.0 if node.laser_ready else 0.0)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "front_distance"}, {"name": "laser_ready"}]}, "size": {"width": "404px", "height": "300px"}}, "position": {"x": 53, "y": 35}}, {"id": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "type": "basic.code", "data": {"code": "import random\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n    TURN_RIGHT = 2.0\n    UTURN_LEFT = 3.0\n    UTURN_RIGHT = 4.0\n    STOP = 5.0\n\n    state = STOP\n\n    stop_distance = 0.60\n    clear_distance = 0.90\n\n    turn_ticks = 0\n\n    normal_turn_ticks = 40\n    uturn_ticks = 80\n\n    while True:\n        distance_wire = inputs.read_number(\"front_distance\")\n        ready_wire = inputs.read_number(\"laser_ready\")\n\n        laser_ready = ready_wire is not None and float(ready_wire[0]) > 0.5\n\n        if not laser_ready or distance_wire is None:\n            state = STOP\n            turn_ticks = 0\n\n        else:\n            front_distance = float(distance_wire[0])\n\n            if state == STOP:\n                state = FORWARD\n\n            if state == FORWARD:\n                if front_distance < stop_distance:\n                    choice = random.choice([\n                        TURN_LEFT,\n                        TURN_RIGHT,\n                        TURN_LEFT,\n                        TURN_RIGHT,\n                        UTURN_LEFT,\n                        UTURN_RIGHT,\n                    ])\n\n                    state = choice\n\n                    if state in [UTURN_LEFT, UTURN_RIGHT]:\n                        turn_ticks = uturn_ticks\n                    else:\n                        turn_ticks = normal_turn_ticks\n\n            elif state in [TURN_LEFT, TURN_RIGHT, UTURN_LEFT, UTURN_RIGHT]:\n                turn_ticks -= 1\n\n                if turn_ticks <= 0 and front_distance > clear_distance:\n                    state = FORWARD\n\n                elif turn_ticks <= -30:\n                    state = FORWARD\n\n        outputs.share_number(\"state_code\", state)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}, {"name": "laser_ready"}], "out": [{"name": "state_code"}]}, "size": {"width": "404px", "height": "300px"}}, "position": {"x": 398, "y": 29}}, {"id": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "type": "basic.code", "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n    TURN_RIGHT = 2.0\n    UTURN_LEFT = 3.0\n    UTURN_RIGHT = 4.0\n\n    forward_speed = 0.70\n    turn_speed = 1.25\n\n    while True:\n        state_wire = inputs.read_number(\"state_code\")\n\n        linear_x = 0.0\n        angular_z = 0.0\n\n        if state_wire is not None:\n            state = float(state_wire[0])\n\n            if state == FORWARD:\n                linear_x = forward_speed\n                angular_z = 0.0\n\n            elif state == TURN_LEFT:\n                linear_x = 0.0\n                angular_z = turn_speed\n\n            elif state == TURN_RIGHT:\n                linear_x = 0.0\n                angular_z = -turn_speed\n\n            elif state == UTURN_LEFT:\n                linear_x = 0.0\n                angular_z = turn_speed\n\n            elif state == UTURN_RIGHT:\n                linear_x = 0.0\n                angular_z = -turn_speed\n\n        outputs.share_number(\"linear_x\", linear_x)\n        outputs.share_number(\"angular_z\", angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "state_code"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}]}, "size": {"width": "300px", "height": "300px"}}, "position": {"x": 677, "y": 386}}, {"id": "2843ebc0-0a57-470a-a397-3615a752123e", "type": "basic.code", "data": {"code": "import rclpy\n\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class VelocityPublisher(Node):\n        def __init__(self):\n            super().__init__(\"vc_velocity_publisher\")\n\n            self.publisher = self.create_publisher(\n                Twist,\n                \"/turtlebot3/cmd_vel\",\n                10,\n            )\n\n        def send_velocity(self, linear_x, angular_z):\n            command = Twist()\n            command.linear.x = float(linear_x)\n            command.angular.z = float(angular_z)\n            self.publisher.publish(command)\n\n    node = VelocityPublisher()\n\n    while True:\n        linear_wire = inputs.read_number(\"linear_x\")\n        angular_wire = inputs.read_number(\"angular_z\")\n\n        linear_x = float(linear_wire[0]) if linear_wire is not None else 0.0\n        angular_z = float(angular_wire[0]) if angular_wire is not None else 0.0\n\n        node.send_velocity(linear_x, angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}], "out": []}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 148, "y": 387}}], "wires": [{"source": {"block": "5edcac28-18c0-420d-acf1-3f3397dbf5ee", "port": "front_distance", "name": "front_distance"}, "target": {"block": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "port": "front_distance", "name": "front_distance"}}, {"source": {"block": "5edcac28-18c0-420d-acf1-3f3397dbf5ee", "port": "laser_ready", "name": "laser_ready"}, "target": {"block": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "port": "laser_ready", "name": "laser_ready"}}, {"source": {"block": "bc999beb-55be-4f5b-ab1a-13eb99501de1", "port": "state_code", "name": "state_code"}, "target": {"block": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "port": "state_code", "name": "state_code"}}, {"source": {"block": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "port": "linear_x", "name": "linear_x"}, "target": {"block": "2843ebc0-0a57-470a-a397-3615a752123e", "port": "linear_x", "name": "linear_x"}}, {"source": {"block": "3ae87f13-e8a3-4cdd-ba7e-3edd16906178", "port": "angular_z", "name": "angular_z"}, "target": {"block": "2843ebc0-0a57-470a-a397-3615a752123e", "port": "angular_z", "name": "angular_z"}}]}}, "dependencies": {}}