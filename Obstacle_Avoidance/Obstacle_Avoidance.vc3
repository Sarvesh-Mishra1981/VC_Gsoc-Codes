-a9ca-49a6-9aaa-aff923b71c24", "locked": true, "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "1e8d9a20-c0fa-49ac-bf8f-e419eaf70280", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"fc46db03-af4c-4ee8-af3c-794247143848": {"id": "fc46db03-af4c-4ee8-af3c-794247143848", "type": "default", "selected": false, "source": "3ff47cb6-13bd-491f-9531-d46fd3b25242", "sourcePort": "71d8c685-aacb-4f69-a283-c58fde872d90", "target": "09880ac7-626b-43ba-a257-3122b3a94710", "targetPort": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "points": [{"id": "b9a91cbe-0582-4a05-af85-1631ad55c0a4", "type": "point", "x": 462.0486454963684, "y": 439.9913487434387}, {"id": "2d3bba1b-31e9-4f13-ae62-045589d08428", "type": "point", "x": 528.0556035041809, "y": 547.1962132453918}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "dc56ba0a-7e88-486e-a516-60b4d2d2e47b": {"id": "dc56ba0a-7e88-486e-a516-60b4d2d2e47b", "type": "default", "selected": false, "source": "878fb43d-238b-4d17-a152-60f34f87aef4", "sourcePort": "b13c8c01-6787-41ce-a99b-510273e0574b", "target": "09880ac7-626b-43ba-a257-3122b3a94710", "targetPort": "d37fce43-929b-4e83-831c-7e98b9884cee", "points": [{"id": "7833c118-ea6f-4874-9b47-276723dec97e", "type": "point", "x": 690.1041874885559, "y": 121.47570848464966}, {"id": "dcb757de-4a4f-4cfa-8046-1e0a492e480c", "type": "point", "x": 982.5173954963684, "y": 249.86979722976685}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "4f38fd9d-8c95-4107-9711-cfd465e91876": {"id": "4f38fd9d-8c95-4107-9711-cfd465e91876", "type": "default", "selected": false, "source": "09880ac7-626b-43ba-a257-3122b3a94710", "sourcePort": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "target": "ef838096-28c8-4cc7-8b1f-1521af42e477", "targetPort": "365e60aa-68cf-46e1-ba34-84e48468aef9", "points": [{"id": "d0441376-29e4-4d5f-802f-47a607fb3801", "type": "point", "x": 1436.9879155158997, "y": 547.1962132453918}, {"id": "c8d318be-f218-4908-b74f-879d9da81883", "type": "point", "x": 1577.0487065315247, "y": 504.9913182258606}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "fcac3d46-b46f-4b24-9e41-e729de31940e", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"3ff47cb6-13bd-491f-9531-d46fd3b25242": {"id": "3ff47cb6-13bd-491f-9531-d46fd3b25242", "type": "basic.input", "selected": false, "x": 369, "y": 414, "ports": [{"id": "71d8c685-aacb-4f69-a283-c58fde872d90", "type": "port.output", "x": 454.54864501953125, "y": 432.49134826660156, "name": "input-out", "alignment": "right", "parentNode": "3ff47cb6-13bd-491f-9531-d46fd3b25242", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "878fb43d-238b-4d17-a152-60f34f87aef4": {"id": "878fb43d-238b-4d17-a152-60f34f87aef4", "type": "basic.constant", "selected": true, "x": 629, "y": 6, "ports": [{"id": "b13c8c01-6787-41ce-a99b-510273e0574b", "type": "port.output", "x": 682.6041870117188, "y": 113.9757080078125, "name": "constant-out", "alignment": "bottom", "parentNode": "878fb43d-238b-4d17-a152-60f34f87aef4", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}}, "09880ac7-626b-43ba-a257-3122b3a94710": {"id": "09880ac7-626b-43ba-a257-3122b3a94710", "type": "basic.code", "selected": false, "x": 520, "y": 173, "ports": [{"id": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "type": "port.input", "x": 520.5556030273438, "y": 539.6962127685547, "name": "Enable", "alignment": "left", "parentNode": "09880ac7-626b-43ba-a257-3122b3a94710", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "type": "port.output", "x": 1429.4879150390625, "y": 539.6962127685547, "name": "Out", "alignment": "right", "parentNode": "09880ac7-626b-43ba-a257-3122b3a94710", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": false, "label": "Out", "hideLabel": false}, {"id": "d37fce43-929b-4e83-831c-7e98b9884cee", "type": "port.parameter", "x": 975.0173950195312, "y": 242.3697967529297, "name": "ROSTopic", "alignment": "top", "parentNode": "09880ac7-626b-43ba-a257-3122b3a94710", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}}, "ef838096-28c8-4cc7-8b1f-1521af42e477": {"id": "ef838096-28c8-4cc7-8b1f-1521af42e477", "type": "basic.output", "selected": false, "x": 1569, "y": 479, "ports": [{"id": "365e60aa-68cf-46e1-ba34-84e48468aef9", "type": "port.input", "x": 1569.5487060546875, "y": 497.49131774902344, "name": "output-in", "alignment": "left", "parentNode": "ef838096-28c8-4cc7-8b1f-1521af42e477", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}}}]}, "info": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "3ff47cb6-13bd-491f-9531-d46fd3b25242", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "878fb43d-238b-4d17-a152-60f34f87aef4", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "09880ac7-626b-43ba-a257-3122b3a94710", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}, "position": {"x": 520, "y": 173}}, {"id": "ef838096-28c8-4cc7-8b1f-1521af42e477", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "3ff47cb6-13bd-491f-9531-d46fd3b25242", "port": "input-out", "name": "Enable"}, "target": {"block": "09880ac7-626b-43ba-a257-3122b3a94710", "port": "Enable", "name": "Enable"}}, {"source": {"block": "878fb43d-238b-4d17-a152-60f34f87aef4", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "09880ac7-626b-43ba-a257-3122b3a94710", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "09880ac7-626b-43ba-a257-3122b3a94710", "port": "Out", "name": "Out"}, "target": {"block": "ef838096-28c8-4cc7-8b1f-1521af42e477", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}, "72126af9-d9e3-4881-a43d-29569727a0f5": {"id": "72126af9-d9e3-4881-a43d-29569727a0f5", "type": "block.package", "selected": true, "x": 201, "y": 411, "ports": [{"id": "3b6febfd-8e4f-4