3-44da-a8e2-d5b3383f067f", "sourcePort": "fba03ed4-1910-48cd-9b0e-ef390442a85b", "target": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "targetPort": "efe71d1e-1ef1-4734-b8e5-d54235c63a36", "points": [{"id": "ffdcb3b7-819b-4cb3-a125-58f29fa457bb", "type": "point", "x": 337.0486454963684, "y": 537.9948582649231}, {"id": "864723fa-8864-4fac-b3ee-7a742a2be96b", "type": "point", "x": 433.0556035041809, "y": 431.20661973953247}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "c58fd49b-840b-4f86-afbb-1970f624f06f", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"8b565109-2183-44da-a8e2-d5b3383f067f": {"id": "8b565109-2183-44da-a8e2-d5b3383f067f", "type": "basic.input", "selected": false, "x": 244, "y": 512, "ports": [{"id": "fba03ed4-1910-48cd-9b0e-ef390442a85b", "type": "port.output", "x": 329.54864501953125, "y": 530.4948577880859, "name": "input-out", "alignment": "right", "parentNode": "8b565109-2183-44da-a8e2-d5b3383f067f", "links": ["97e7a72d-6aaa-40b7-a330-cae873eb57a5"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "dfbb0a58-dca9-4af2-a74d-04c5113df55c": {"id": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "type": "basic.output", "selected": false, "x": 1412, "y": 514, "ports": [{"id": "36b882fa-7cb9-449b-ac0b-ceafd50b5321", "type": "port.input", "x": 1412.5521240234375, "y": 532.4913787841797, "name": "output-in", "alignment": "left", "parentNode": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "links": ["b55e85cc-82d2-4e4c-84b2-c8f17affc430"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}, "7728d564-d237-4bd5-820c-ffc7e3b9e66b": {"id": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "type": "basic.constant", "selected": true, "x": 821, "y": 13, "ports": [{"id": "54a31c83-d088-444d-8daa-e297806504e4", "type": "port.output", "x": 874.6094360351562, "y": 120.97222900390625, "name": "constant-out", "alignment": "bottom", "parentNode": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "links": ["fe8087ec-cdcd-4957-98f7-d40632907fac"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/webgui/current_target", "local": true}}, "77c23aaf-2ad4-443a-84cb-a38ee06f5168": {"id": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "type": "basic.code", "selected": false, "x": 425, "y": 181, "ports": [{"id": "efe71d1e-1ef1-4734-b8e5-d54235c63a36", "type": "port.input", "x": 425.55560302734375, "y": 423.7066192626953, "name": "Enable", "alignment": "left", "parentNode": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "links": ["97e7a72d-6aaa-40b7-a330-cae873eb57a5"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "509994c2-03c9-4d40-87d4-e4a725ce1f74", "type": "port.output", "x": 780.494873046875, "y": 423.7066192626953, "name": "Out", "alignment": "right", "parentNode": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "links": ["b55e85cc-82d2-4e4c-84b2-c8f17affc430"], "in": false, "label": "Out", "hideLabel": false}, {"id": "253fc57c-e90e-489b-a4ee-610a80c56915", "type": "port.parameter", "x": 603.0208740234375, "y": 250.37327575683594, "name": "ROSTopic", "alignment": "top", "parentNode": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "links": ["fe8087ec-cdcd-4957-98f7-d40632907fac"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\nimport rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Point\nfrom rclpy.qos import QoSProfile, DurabilityPolicy\n\ncurrent_target = None\n\nclass TargetSubscriber(Node):\n    def __init__(self, topic):\n        super().__init__('target_subscriber')\n        qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)\n        self.subscription = self.create_subscription(Point, topic, self.callback, qos)\n\n    def callback(self, msg):\n        global current_target\n        current_target = [float(msg.x), float(msg.y)]\n\ndef main(inputs, outputs, parameters, synchronise):\n    global current_target\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    rclpy.init()\n    target_sub = TargetSubscriber(parameters.read_string(\"ROSTopic\"))\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            current_target = None\n            rclpy.spin_once(target_sub, timeout_sec=0)\n            if current_target is not None:\n                outputs.share_array(\"Out\", current_target)   \n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        target_sub.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "300px", "height": "300px"}}}}}]}, "info": {"name": "ROS2Camera", "version": "2.0.0", "description": "Captures Video Stream from Simulated ROS2 Camera", "author": "David Tapiador de Vera", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "8b565109-2183-44da-a8e2-d5b3383f067f", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 244, "y": 512}}, {"id": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1412, "y": 514}}, {"id": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/webgui/current_target", "local": true}, "position": {"x": 821, "y": 13}}, {"id": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Point\nfrom rclpy.qos import QoSProfile, DurabilityPolicy\n\ncurrent_target = None\n\nclass TargetSubscriber(Node):\n    def __init__(self, topic):\n        super().__init__('target_subscriber')\n        qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)\n        self.subscription = self.create_subscription(Point, topic, self.callback, qos)\n\n    def callback(self, msg):\n        global current_target\n        current_target = [float(msg.x), float(msg.y)]\n\ndef main(inputs, outputs, parameters, synchronise):\n    global current_target\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    rclpy.init()\n    target_sub = TargetSubscriber(parameters.read_string(\"ROSTopic\"))\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            current_target = None\n            rclpy.spin_once(target_sub, timeout_sec=0)\n            if current_target is not None:\n                outputs.share_array(\"Out\", current_target)   \n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        target_sub.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "300px", "height": "300px"}}, "position": {"x": 425, "y": 181}}], "wires": [{"source": {"block": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Out", "name": "Out"}, "target": {"block": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "port": "output-in", "name": "output-in"}}, {"source": {"block": "8b565109-2183-44da-a8e2-d5b3383f067f", "port": "input-out", "name": "Enable"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Enable", "name": "Enable"}}]}}, "dependencies": {}}, "a3c5367d-f9fd-4d1f-955b-4421e0678db8": {"id": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "type": "basic.code", "selected": false, "x": 568, "y": 81, "ports": [{"id": "9161e0d7-93bc-4fc1-b192-8566c1260bfa", "type": "port.input", "x": 568.5503540039062, "y": 214.8697967529297, "name": "LaserIn", "alignment": "left", "parentNode": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "links": ["3ef54281-9938-4e37-b995-bf9537121342"], "in": true, "label": "LaserIn", "hideLabel": false}, {"id": "5f22de7b-8e76-4663-b64c-662cf695e6e9", "type": "port.input", "x": 568.5503540039062, "y": 306.0330047607422, "name": "OdomIn", "alignment": "left", "parentNode": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "links": ["ea499663-107e-4a4a-8a31-ac7000e03db9"], "in": true, "label": "OdomIn", "hideLabel": false}, {"id": "3ce4bf99-d503-4d26-9130-b3945b2b5e04", "type": "port.input", "x": 568.5503540039062, "y": 397.2048797607422, "name": "TargetIn", "alignment": "left", "parentNode": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "links": ["87bc8ccb-080c-43ee-bcac-b057d6fdcfdf"], "in": true, "label": "TargetIn", "hideLabel": false}, {"id": "3d27cb53-32c2-461a-ab3f-f1f0e62b8bb3", "type": "port.output", "x": 1054.6614990234375, "y": 306.0330047607422, "name": "VelsOut", "alignment": "right", "parentNode": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "links": ["3578d625-0ece-4d64-ada1-bf65414aed6d"], "in": false, "label": "VelsOut", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\nimport math\nimport rclpy\nfrom rclpy.node import Node\nfrom std_msgs.msg import Bool\n\nclass VFFBrain(Node):\n    def __init__(self):\n        super().__init__('vff_brain')\n        self.reached_pub = self.create_publisher(Bool, '/webgui/target_reached', 1)\n    def mark_reached(self):\n        msg = Bool()\n        msg.data = True\n        self.reached_pub.publish(msg)\n\ndef absolute2relative(x_abs, y_abs, robotx, roboty, robott):\n    dx = x_abs - robotx\n    dy = y_abs - roboty\n    x_rel = dx * math.cos(-robott) - dy * math.sin(-robott)\n    y_rel = dx * math.sin(-robott) + dy * math.cos(-robott)\n    return x_rel, y_rel\n\ndef main(inputs, outputs, parameters, synchronise):\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    brain_node = VFFBrain()\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            laser_data = inputs.read_array('LaserIn')\n            odom_data = inputs.read_array('OdomIn')\n            target_data = inputs.read_array('TargetIn')\n\n            if laser_data is not None and odom_data is not None and target_data is not None:\n                robotx, roboty, robott = odom_data[0], odom_data[1], odom_data[2]\n                target_abs_x, target_abs_y = target_data[0], target_data[1]\n\n                target_rel_x, target_rel_y = absolute2relative(target_abs_x, target_abs_y, robotx, roboty, robott)\n                \n                distance_to_target = math.sqrt(target_rel_x**2 + target_rel_y**2)\n                if distance_to_target < 2.5:\n                    brain_node.mark_reached()\n\n                target_weight = 4.0\n                if distance_to_target > 0:\n                    carForce = [(target_rel_x / distance_to_target) * target_weight, \n                                (target_rel_y / distance_to_target) * target_weight]\n                else:\n                    carForce = [0.0, 0.0]\n\n                obs_x = 0.0\n                obs_y = 0.0\n                \n                for i in range(len(laser_data)):\n                    dist = float(laser_data[i])\n                    if dist < 3.0:\n                        angle = math.radians(i - 90)\n                        repulsive_magnitude = 1.0 / (dist ** 2)\n                        obs_x -= repulsive_magnitude * math.cos(angle)\n                        obs_y -= repulsive_magnitude * math.sin(angle)\n\n                obstacle_weight = 12.0\n                obsForce = [obs_x * obstacle_weight, obs_y * obstacle_weight]\n\n                avgForce = [carForce[0] + obsForce[0], carForce[1] + obsForce[1]]\n\n                v = 3.0\n                w = avgForce[1] * 0.35\n                \n                if w > 1.2: w = 1.2\n                if w < -1.2: w = -1.2\n\n                outputs.share_array(\"VelsOut\", [v, 0.0, 0.0, 0.0, 0.0, w])\n\n            rclpy.spin_once(brain_node, timeout_sec=0)\n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        brain_node.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [], "ports": {"in": [{"name": "LaserIn"}, {"name": "OdomIn"}, {"name": "TargetIn"}], "out": [{"name": "VelsOut"}]}, "size": {"width": "404px", "height": "318px"}}}, "503b0d84-cb1e-4e67-bc0e-a19d147d2260": {"id": "503b0d84-cb1e-4e67-bc0e-a19d147d2260", "type": "block.package", "selected": false, "x": 1403, "y": 241, "ports": [{"id": "d0d6eb4a-6a29-4871-becd-73fd81f1fdb5", "type": "port.input", "x": 1403.5504150390625, "y": 257.10939025878906, "name": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "alignment": "left", "parentNode": "503b0d84-cb1e-4e67-bc0e-a19d147d2260", "links": ["3578d625-0ece-4d64-ada1-bf65414aed6d"], "in": true, "label": "Vels", "hideLabel": false}, {"id": "163a3ff5-cdca-4519-b05f-c8a34b06e70f", "type": "port.input", "x": 1403.5504150390625, "y": 299.3316192626953, "name": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "alignment": "left", "parentNode": "503b0d84-cb1e-4e67-bc0e-a19d147d2260", "links": ["07d21c76-371a-40ba-b1fe-d96cc031e976"], "in": true, "label": "Enable", "hideLabel": false}], "data": {}, "model": {"id": "bb24521a-8c41-4f55-8e96-b7aff41c4297", "locked": true, "offsetX": 36, "offsetY": 98, "zoom": 100, "gridSize": 0, "layers": [{"id": "50937002-f39a-4d49-a9eb-39771635497f", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"1e2cd58f-7aae-41e9-bfbb-777e1296b017": {"id": "1e2cd58f-7aae-41e9-bfbb-777e1296b017", "type": "default", "selected": false, "source": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "sourcePort": "a23d135a-c5ad-4eac-8978-9c8fdae27da3", "target": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "targetPort": "85b9140d-79ee-46ae-942e-f103dfe70aae", "points": [{"id": "7b0064bc-9032-4093-9745-1b9add0d01ce", "type": "point", "x": 188.05557298660278, "y": 257.99482774734497}, {"id": "c7264bba-cc90-4fb5-82e7-270afc776544", "type": "point", "x": 377.0486454963684, "y": 352.43058824539185}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "f13df527-0eea-46a7-ba57-c8967f56a2d6": {"id": "f13df527-0eea-46a7-ba57-c8967f56a2d6", "type": "default", "selected": false, "source": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "sourcePort": "80c09fc1-951c-412b-8395-f298f56faf68", "target": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "targetPort": "424fe5f3-8908-46b3-81f2-47e3b7acd14f", "points": [{"id": "50a22531-04b5-408c-8805-3d9f8bad3982", "type": "point", "x": 192.04861497879028, "y": 363.99308824539185}, {"id": "aa570841-6125-4a9d-97c3-68476d81013e", "type": "point", "x": 377.0486454963684, "y": 562.9861302375793}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "3ff23423-89db-4495-bc80-ec747b014e77": {"id": "3ff23423-89db-4495-bc80-ec747b014e77", "type": "default", "selected": false, "source": "23fb490e-ff0f-468b-acd7-02265df2b67f", "sourcePort": "a6d95f72-926d-4334-9737-9b6e9b4206c0", "target": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "targetPort": "42dddbf9-3f8e-45b9-8a50-7ba984f72abf", "points": [{"id": "e517fdd6-87e8-44b6-80d9-8f6da0b71dbe", "type": "point", "x": 863.5504155158997, "y": 36.92709398269653}, {"id": "70c6e2da-8e29-486a-a19d-25fcfad41f8b", "type": "point", "x": 889.7396245002747, "y": 141.87501573562622}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "220b70ae-199a-4bc2-8a5d-05e7ec6ae5ca", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"bdd1c656-0399-4d58-9736-8731a8cf9ff9": {"id": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "type": "basic.input", "selected": false, "x": 95, "y": 232, "ports": [{"id": "a23d135a-c5ad-4eac-8978-9c8fdae27da3", "type": "port.output", "x": 180.55557250976562, "y": 250.4948272705078, "name": "input-out", "alignment": "right", "parentNode": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "links": ["1e2cd58f-7aae-41e9-bfbb-777e1296b017"], "in": false, "label": "Vels", "hideLabel": true}], "data": {"name": "Vels"}}, "571b0e62-90c4-41db-bf5f-78c6eb52475a": {"id": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "type": "basic.input", "selected": false, "x": 99, "y": 338, "ports": [{"id": "80c09fc1-951c-412b-8395-f298f56faf68", "type": "port.output", "x": 184.54861450195312, "y": 356.4930877685547, "name": "input-out", "alignment": "right", "parentNode": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "links": ["f13df527-0eea-46a7-ba57-c8967f56a2d6"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "fb3d38dd-df22-4df5-ae17-326fff691c3d": {"id": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "type": "basic.code", "selected": false, "x": 369, "y": 65, "ports": [{"id": "85b9140d-79ee-46ae-942e-f103dfe70aae", "type": "port.input", "x": 369.54864501953125, "y": 344.9305877685547, "name": "Vels", "alignment": "left", "parentNode": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "links": ["1e2cd58f-7aae-41e9-bfbb-777e1296b017"], "in": true, "label": "Vels", "hideLabel": false}, {"id": "424fe5f3-8908-46b3-81f2-47e3b7acd14f", "type": "port.input", "x": 369.54864501953125, "y": 555.4861297607422, "name": "Enable", "alignment": "left", "parentNode": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "links": ["f13df527-0eea-46a7-ba57-c8967f56a2d6"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "42dddbf9-3f8e-45b9-8a50-7ba984f72abf", "type": "port.parameter", "x": 882.2396240234375, "y": 134.37501525878906, "name": "ROSTopic", "alignment": "top", "parentNode": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "links": ["3ff23423-89db-4495-bc80-ec747b014e77"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\nimport rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\nvelocities = 0\n\nclass VelPublisher(Node):\n    def __init__(self, topic):\n        super().__init__('vel_publisher')\n        self.publisher_ = self.create_publisher(Twist, topic, 1)\n        timer_period = 0.1  # Fast updates\n        self.timer = self.create_timer(timer_period, self.timer_callback)\n\n    def timer_callback(self):\n        global velocities\n        msg = Twist()\n        try:\n            msg.linear.x = float(velocities[0])\n            msg.linear.y = float(velocities[1])\n            msg.linear.z = float(velocities[2])\n            msg.angular.x = float(velocities[3])\n            msg.angular.y = float(velocities[4])\n            msg.angular.z = float(velocities[5])\n        except (IndexError, TypeError):\n            return\n        self.publisher_.publish(msg)\n\ndef main(inputs, outputs, parameters, synchronise):\n    global velocities\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    vel_publisher = VelPublisher(parameters.read_string('ROSTopic'))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            v_input = inputs.read_array('Vels')\n            if v_input is not None:\n                velocities = v_input\n                rclpy.spin_once(vel_publisher, timeout_sec=0) \n            synchronise()   \n    except Exception as e:\n        pass\n    finally:\n        synchronise()\n        vel_publisher.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Vels"}, {"name": "Enable"}], "out": []}, "size": {"width": "925px", "height": "300px"}}}, "23fb490e-ff0f-468b-acd7-02265df2b67f": {"id": "23fb490e-ff0f-468b-acd7-02265df2b67f", "type": "basic.constant", "selected": false, "x": 803, "y": -78, "ports": [{"id": "a6d95f72-926d-4334-9737-9b6e9b4206c0", "type": "port.output", "x": 856.0504150390625, "y": 29.427093505859375, "name": "constant-out", "alignment": "bottom", "parentNode": "23fb490e-ff0f-468b-acd7-02265df2b67f", "links": ["3ff23423-89db-4495-bc80-ec747b014e77"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/cmd_vel", "local": true}}}}]}, "info": {"name": "ROS2MotorDriver", "version": "1.0.0", "description": "Controls Robot's Movement using ROS2.", "author": "David Tapiador de Vera", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "type": "basic.input", "data": {"name": "Vels"}, "position": {"x": 95, "y": 232}}, {"id": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 99, "y": 338}}, {"id": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\nvelocities = 0\n\nclass VelPublisher(Node):\n    def __init__(self, topic):\n        super().__init__('vel_publisher')\n        self.publisher_ = self.create_publisher(Twist, topic, 1)\n        timer_period = 0.1  # Fast updates\n        self.timer = self.create_timer(timer_period, self.timer_callback)\n\n    def timer_callback(self):\n        global velocities\n        msg = Twist()\n        try:\n            msg.linear.x = float(velocities[0])\n            msg.linear.y = float(velocities[1])\n            msg.linear.z = float(velocities[2])\n            msg.angular.x = float(velocities[3])\n            msg.angular.y = float(velocities[4])\n            msg.angular.z = float(velocities[5])\n        except (IndexError, TypeError):\n            return\n        self.publisher_.publish(msg)\n\ndef main(inputs, outputs, parameters, synchronise):\n    global velocities\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    vel_publisher = VelPublisher(parameters.read_string('ROSTopic'))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            v_input = inputs.read_array('Vels')\n            if v_input is not None:\n                velocities = v_input\n                rclpy.spin_once(vel_publisher, timeout_sec=0) \n            synchronise()   \n    except Exception as e:\n        pass\n    finally:\n        synchronise()\n        vel_publisher.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Vels"}, {"name": "Enable"}], "out": []}, "size": {"width": "925px", "height": "300px"}}, "position": {"x": 369, "y": 65}}, {"id": "23fb490e-ff0f-468b-acd7-02265df2b67f", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/cmd_vel", "local": true}, "position": {"x": 803, "y": -78}}], "wires": [{"source": {"block": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "port": "input-out", "name": "Vels"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Vels", "name": "Vels"}}, {"source": {"block": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "port": "input-out", "name": "Enable"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Enable", "name": "Enable"}}, {"source": {"block": "23fb490e-ff0f-468b-acd7-02265df2b67f", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "ROSTopic", "name": "ROSTopic"}}]}}, "dependencies": {}}, "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b": {"id": "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b", "type": "basic.constant", "selected": false, "x": 43, "y": 514, "ports": [{"id": "cca0aa36-09e4-46a3-a99b-641e49bc63ce", "type": "port.output", "x": 96.05035400390625, "y": 621.4149627685547, "name": "constant-out", "alignment": "bottom", "parentNode": "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b", "links": ["c00a0397-9596-4343-afa4-e8b108599b20", "9791b48a-9428-4706-a02d-34e42e2375c4", "4811b7f6-858d-4136-9064-299e1b6b149f"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable", "value": "1", "local": true}}}}]}, "version": "3.0", "package": {"name": "Obstacle avoidance ", "version": "", "description": "", "author": "", "image": "", "category": "", "tags": []}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "7ed41c52-7c85-4f0b-bae1-e06d5b1286b7", "type": "a29gKISX7DZR0e08g66lJ0LA9blTVKr5EwyLbon2", "data": {}, "position": {"x": 134, "y": 293}}, {"id": "e64c0d6a-5b7e-431b-a9f7-a4580aed6d8c", "type": "LRsAqz6XGx77TFyDO2fvFTGwTA6LX6EgDDERfe7F", "data": {}, "position": {"x": 101, "y": 162}}, {"id": "c760ddae-6483-4eac-9961-f19ee2337c38", "type": "0VsmfSjcmGL4EVnvzplQb6l1O9zuVMC0DNhY6KGj", "data": {}, "position": {"x": 140, "y": 413}}, {"id": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport math\nimport rclpy\nfrom rclpy.node import Node\nfrom std_msgs.msg import Bool\n\nclass VFFBrain(Node):\n    def __init__(self):\n        super().__init__('vff_brain')\n        self.reached_pub = self.create_publisher(Bool, '/webgui/target_reached', 1)\n    def mark_reached(self):\n        msg = Bool()\n        msg.data = True\n        self.reached_pub.publish(msg)\n\ndef absolute2relative(x_abs, y_abs, robotx, roboty, robott):\n    dx = x_abs - robotx\n    dy = y_abs - roboty\n    x_rel = dx * math.cos(-robott) - dy * math.sin(-robott)\n    y_rel = dx * math.sin(-robott) + dy * math.cos(-robott)\n    return x_rel, y_rel\n\ndef main(inputs, outputs, parameters, synchronise):\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    brain_node = VFFBrain()\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            laser_data = inputs.read_array('LaserIn')\n            odom_data = inputs.read_array('OdomIn')\n            target_data = inputs.read_array('TargetIn')\n\n            if laser_data is not None and odom_data is not None and target_data is not None:\n                robotx, roboty, robott = odom_data[0], odom_data[1], odom_data[2]\n                target_abs_x, target_abs_y = target_data[0], target_data[1]\n\n                target_rel_x, target_rel_y = absolute2relative(target_abs_x, target_abs_y, robotx, roboty, robott)\n                \n                distance_to_target = math.sqrt(target_rel_x**2 + target_rel_y**2)\n                if distance_to_target < 2.5:\n                    brain_node.mark_reached()\n\n                target_weight = 4.0\n                if distance_to_target > 0:\n                    carForce = [(target_rel_x / distance_to_target) * target_weight, \n                                (target_rel_y / distance_to_target) * target_weight]\n                else:\n                    carForce = [0.0, 0.0]\n\n                obs_x = 0.0\n                obs_y = 0.0\n                \n                for i in range(len(laser_data)):\n                    dist = float(laser_data[i])\n                    if dist < 3.0:\n                        angle = math.radians(i - 90)\n                        repulsive_magnitude = 1.0 / (dist ** 2)\n                        obs_x -= repulsive_magnitude * math.cos(angle)\n                        obs_y -= repulsive_magnitude * math.sin(angle)\n\n                obstacle_weight = 12.0\n                obsForce = [obs_x * obstacle_weight, obs_y * obstacle_weight]\n\n                avgForce = [carForce[0] + obsForce[0], carForce[1] + obsForce[1]]\n\n                v = 3.0\n                w = avgForce[1] * 0.35\n                \n                if w > 1.2: w = 1.2\n                if w < -1.2: w = -1.2\n\n                outputs.share_array(\"VelsOut\", [v, 0.0, 0.0, 0.0, 0.0, w])\n\n            rclpy.spin_once(brain_node, timeout_sec=0)\n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        brain_node.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [], "ports": {"in": [{"name": "LaserIn"}, {"name": "OdomIn"}, {"name": "TargetIn"}], "out": [{"name": "VelsOut"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 568, "y": 81}}, {"id": "503b0d84-cb1e-4e67-bc0e-a19d147d2260", "type": "qUyYdWOeXq9NS6JntRBAoD9p51Hh1GQl3IciR90c", "data": {}, "position": {"x": 1403, "y": 241}}, {"id": "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b", "type": "basic.constant", "data": {"name": "Enable", "value": "1", "local": true}, "position": {"x": 43, "y": 514}}], "wires": [{"source": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Out", "name": "Out"}, "target": {"block": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "port": "LaserIn", "name": "LaserIn"}}, {"source": {"block": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "port": "VelsOut", "name": "VelsOut"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Vels", "name": "Vels"}}, {"source": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Out", "name": "Out"}, "target": {"block": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "port": "OdomIn", "name": "OdomIn"}}, {"source": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Out", "name": "Out"}, "target": {"block": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "port": "TargetIn", "name": "TargetIn"}}, {"source": {"block": "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b", "port": "constant-out", "name": "Enable"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Enable", "name": "Enable"}}, {"source": {"block": "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b", "port": "constant-out", "name": "Enable"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Enable", "name": "Enable"}}, {"source": {"block": "0010-ea50af33-255e-4417-8b30-f69f40ad4f4b", "port": "constant-out", "name": "Enable"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Enable", "name": "Enable"}}, {"source": {"block": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Enable", "name": "Enable"}}, {"source": {"block": "020c75b8-787c-4794-98cb-6bf9f189da1e", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Out", "name": "Out"}, "target": {"block": "f9e44988-31f0-4d4e-889c-166705cb456e", "port": "output-in", "name": "output-in", "ob": "absent"}}, {"source": {"block": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Enable", "name": "Enable"}}, {"source": {"block": "7f46902d-13d6-4284-84bd-3e51567ba674", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Out", "name": "Out"}, "target": {"block": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "port": "output-in", "name": "output-in", "ob": "absent"}}, {"source": {"block": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Out", "name": "Out"}, "target": {"block": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "port": "output-in", "name": "output-in", "ob": "absent"}}, {"source": {"block": "8b565109-2183-44da-a8e2-d5b3383f067f", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Enable", "name": "Enable"}}, {"source": {"block": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "port": "input-out", "name": "Vels", "ob": "absent"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Vels", "name": "Vels"}}, {"source": {"block": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Enable", "name": "Enable"}}, {"source": {"block": "23fb490e-ff0f-468b-acd7-02265df2b67f", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "ROSTopic", "name": "ROSTopic"}}]}}, "dependencies": {"a29gKISX7DZR0e08g66lJ0LA9blTVKr5EwyLbon2": {"package": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "020c75b8-787c-4794-98cb-6bf9f189da1e", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "791px", "height": "300px"}}, "position": {"x": 520, "y": 173}}, {"id": "f9e44988-31f0-4d4e-889c-166705cb456e", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Enable", "name": "Enable"}}, {"source": {"block": "020c75b8-787c-4794-98cb-6bf9f189da1e", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Out", "name": "Out"}, "target": {"block": "f9e44988-31f0-4d4e-889c-166705cb456e", "port": "output-in", "name": "output-in", "ob": "absent"}}]}}, "dependencies": {}}, "LRsAqz6XGx77TFyDO2fvFTGwTA6LX6EgDDERfe7F": {"package": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "7f46902d-13d6-4284-84bd-3e51567ba674", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/odom", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport math\nimport rclpy\nfrom rclpy.node import Node\nfrom nav_msgs.msg import Odometry\n\nrobot_pose = None\n\nclass OdomSubscriber(Node):\n    def __init__(self, topic):\n        super().__init__('odom_subscriber')\n        self.subscription = self.create_subscription(Odometry, topic, self.callback, 10)\n\n    def callback(self, msg):\n        global robot_pose\n        x = msg.pose.pose.position.x\n        y = msg.pose.pose.position.y\n        q = msg.pose.pose.orientation\n        siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)\n        cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n        yaw = math.atan2(siny_cosp, cosy_cosp)\n        robot_pose = [float(x), float(y), float(yaw)]\n\ndef main(inputs, outputs, parameters, synchronise):\n    global robot_pose\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    rclpy.init()\n    odom_sub = OdomSubscriber(parameters.read_string(\"ROSTopic\"))\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            robot_pose = None\n            rclpy.spin_once(odom_sub, timeout_sec=0)\n            if robot_pose is not None:\n                outputs.share_array(\"Out\", robot_pose)   \n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        odom_sub.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "791px", "height": "300px"}}, "position": {"x": 520, "y": 173}}, {"id": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Enable", "name": "Enable"}}, {"source": {"block": "7f46902d-13d6-4284-84bd-3e51567ba674", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Out", "name": "Out"}, "target": {"block": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "port": "output-in", "name": "output-in", "ob": "absent"}}]}}, "dependencies": {}}, "0VsmfSjcmGL4EVnvzplQb6l1O9zuVMC0DNhY6KGj": {"package": {"name": "ROS2Camera", "version": "2.0.0", "description": "Captures Video Stream from Simulated ROS2 Camera", "author": "David Tapiador de Vera", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "8b565109-2183-44da-a8e2-d5b3383f067f", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 244, "y": 512}}, {"id": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1412, "y": 514}}, {"id": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/webgui/current_target", "local": true}, "position": {"x": 821, "y": 13}}, {"id": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Point\nfrom rclpy.qos import QoSProfile, DurabilityPolicy\n\ncurrent_target = None\n\nclass TargetSubscriber(Node):\n    def __init__(self, topic):\n        super().__init__('target_subscriber')\n        qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)\n        self.subscription = self.create_subscription(Point, topic, self.callback, qos)\n\n    def callback(self, msg):\n        global current_target\n        current_target = [float(msg.x), float(msg.y)]\n\ndef main(inputs, outputs, parameters, synchronise):\n    global current_target\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    rclpy.init()\n    target_sub = TargetSubscriber(parameters.read_string(\"ROSTopic\"))\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            current_target = None\n            rclpy.spin_once(target_sub, timeout_sec=0)\n            if current_target is not None:\n                outputs.share_array(\"Out\", current_target)   \n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        target_sub.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "300px", "height": "300px"}}, "position": {"x": 425, "y": 181}}], "wires": [{"source": {"block": "7728d564-d237-4bd5-820c-ffc7e3b9e66b", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Out", "name": "Out"}, "target": {"block": "dfbb0a58-dca9-4af2-a74d-04c5113df55c", "port": "output-in", "name": "output-in", "ob": "absent"}}, {"source": {"block": "8b565109-2183-44da-a8e2-d5b3383f067f", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "77c23aaf-2ad4-443a-84cb-a38ee06f5168", "port": "Enable", "name": "Enable"}}]}}, "dependencies": {}}, "qUyYdWOeXq9NS6JntRBAoD9p51Hh1GQl3IciR90c": {"package": {"name": "ROS2MotorDriver", "version": "1.0.0", "description": "Controls Robot's Movement using ROS2.", "author": "David Tapiador de Vera", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "type": "basic.input", "data": {"name": "Vels"}, "position": {"x": 95, "y": 232}}, {"id": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 99, "y": 338}}, {"id": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\nvelocities = 0\n\nclass VelPublisher(Node):\n    def __init__(self, topic):\n        super().__init__('vel_publisher')\n        self.publisher_ = self.create_publisher(Twist, topic, 1)\n        timer_period = 0.1  # Fast updates\n        self.timer = self.create_timer(timer_period, self.timer_callback)\n\n    def timer_callback(self):\n        global velocities\n        msg = Twist()\n        try:\n            msg.linear.x = float(velocities[0])\n            msg.linear.y = float(velocities[1])\n            msg.linear.z = float(velocities[2])\n            msg.angular.x = float(velocities[3])\n            msg.angular.y = float(velocities[4])\n            msg.angular.z = float(velocities[5])\n        except (IndexError, TypeError):\n            return\n        self.publisher_.publish(msg)\n\ndef main(inputs, outputs, parameters, synchronise):\n    global velocities\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    vel_publisher = VelPublisher(parameters.read_string('ROSTopic'))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            v_input = inputs.read_array('Vels')\n            if v_input is not None:\n                velocities = v_input\n                rclpy.spin_once(vel_publisher, timeout_sec=0) \n            synchronise()   \n    except Exception as e:\n        pass\n    finally:\n        synchronise()\n        vel_publisher.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Vels"}, {"name": "Enable"}], "out": []}, "size": {"width": "925px", "height": "300px"}}, "position": {"x": 369, "y": 65}}, {"id": "23fb490e-ff0f-468b-acd7-02265df2b67f", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/cmd_vel", "local": true}, "position": {"x": 803, "y": -78}}], "wires": [{"source": {"block": "bdd1c656-0399-4d58-9736-8731a8cf9ff9", "port": "input-out", "name": "Vels", "ob": "absent"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Vels", "name": "Vels"}}, {"source": {"block": "571b0e62-90c4-41db-bf5f-78c6eb52475a", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "Enable", "name": "Enable"}}, {"source": {"block": "23fb490e-ff0f-468b-acd7-02265df2b67f", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "fb3d38dd-df22-4df5-ae17-326fff691c3d", "port": "ROSTopic", "name": "ROSTopic"}}]}}, "dependencies": {}}}}