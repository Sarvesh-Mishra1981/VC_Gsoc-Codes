rmed": true, "models": {"7ed41c52-7c85-4f0b-bae1-e06d5b1286b7": {"id": "7ed41c52-7c85-4f0b-bae1-e06d5b1286b7", "type": "block.package", "selected": false, "x": 134, "y": 293, "ports": [{"id": "0ea77143-7cf8-4f7f-a475-60dd03609f23", "type": "port.input", "x": 134.54861450195312, "y": 330.21702575683594, "name": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "alignment": "left", "parentNode": "7ed41c52-7c85-4f0b-bae1-e06d5b1286b7", "links": ["9791b48a-9428-4706-a02d-34e42e2375c4"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "7dcca1e9-d19d-4ed2-8d8b-5df295c59c49", "type": "port.output", "x": 249.5486297607422, "y": 330.21702575683594, "name": "f9e44988-31f0-4d4e-889c-166705cb456e", "alignment": "right", "parentNode": "7ed41c52-7c85-4f0b-bae1-e06d5b1286b7", "links": ["3ef54281-9938-4e37-b995-bf9537121342"], "in": false, "label": "Out", "hideLabel": false}], "data": {}, "model": {"id": "f2c89810-a9ca-49a6-9aaa-aff923b71c24", "locked": true, "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "1e8d9a20-c0fa-49ac-bf8f-e419eaf70280", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"fc46db03-af4c-4ee8-af3c-794247143848": {"id": "fc46db03-af4c-4ee8-af3c-794247143848", "type": "default", "selected": false, "source": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "sourcePort": "71d8c685-aacb-4f69-a283-c58fde872d90", "target": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "targetPort": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "points": [{"id": "b9a91cbe-0582-4a05-af85-1631ad55c0a4", "type": "point", "x": 462.0486454963684, "y": 439.9913487434387}, {"id": "2d3bba1b-31e9-4f13-ae62-045589d08428", "type": "point", "x": 528.0556035041809, "y": 547.1962132453918}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "dc56ba0a-7e88-486e-a516-60b4d2d2e47b": {"id": "dc56ba0a-7e88-486e-a516-60b4d2d2e47b", "type": "default", "selected": false, "source": "020c75b8-787c-4794-98cb-6bf9f189da1e", "sourcePort": "b13c8c01-6787-41ce-a99b-510273e0574b", "target": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "targetPort": "d37fce43-929b-4e83-831c-7e98b9884cee", "points": [{"id": "7833c118-ea6f-4874-9b47-276723dec97e", "type": "point", "x": 689.5486454963684, "y": 120.9201512336731}, {"id": "dcb757de-4a4f-4cfa-8046-1e0a492e480c", "type": "point", "x": 982.5173954963684, "y": 249.86979722976685}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "4f38fd9d-8c95-4107-9711-cfd465e91876": {"id": "4f38fd9d-8c95-4107-9711-cfd465e91876", "type": "default", "selected": false, "source": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "sourcePort": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "target": "f9e44988-31f0-4d4e-889c-166705cb456e", "targetPort": "365e60aa-68cf-46e1-ba34-84e48468aef9", "points": [{"id": "d0441376-29e4-4d5f-802f-47a607fb3801", "type": "point", "x": 1436.9879155158997, "y": 547.1962132453918}, {"id": "c8d318be-f218-4908-b74f-879d9da81883", "type": "point", "x": 1577.0487065315247, "y": 504.9913182258606}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "fcac3d46-b46f-4b24-9e41-e729de31940e", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"4caadb3a-553d-47a6-aee3-ff9d658596c4": {"id": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "type": "basic.input", "selected": false, "x": 369, "y": 414, "ports": [{"id": "71d8c685-aacb-4f69-a283-c58fde872d90", "type": "port.output", "x": 454.54864501953125, "y": 432.49134826660156, "name": "input-out", "alignment": "right", "parentNode": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "020c75b8-787c-4794-98cb-6bf9f189da1e": {"id": "020c75b8-787c-4794-98cb-6bf9f189da1e", "type": "basic.constant", "selected": false, "x": 629, "y": 6, "ports": [{"id": "b13c8c01-6787-41ce-a99b-510273e0574b", "type": "port.output", "x": 682.0486450195312, "y": 113.42015075683594, "name": "constant-out", "alignment": "bottom", "parentNode": "020c75b8-787c-4794-98cb-6bf9f189da1e", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}}, "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e": {"id": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "type": "basic.code", "selected": false, "x": 520, "y": 173, "ports": [{"id": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "type": "port.input", "x": 520.5556030273438, "y": 539.6962127685547, "name": "Enable", "alignment": "left", "parentNode": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "type": "port.output", "x": 1429.4879150390625, "y": 539.6962127685547, "name": "Out", "alignment": "right", "parentNode": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": false, "label": "Out", "hideLabel": false}, {"id": "d37fce43-929b-4e83-831c-7e98b9884cee", "type": "port.parameter", "x": 975.0173950195312, "y": 242.3697967529297, "name": "ROSTopic", "alignment": "top", "parentNode": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "791px", "height": "300px"}}}, "f9e44988-31f0-4d4e-889c-166705cb456e": {"id": "f9e44988-31f0-4d4e-889c-166705cb456e", "type": "basic.output", "selected": false, "x": 1569, "y": 479, "ports": [{"id": "365e60aa-68cf-46e1-ba34-84e48468aef9", "type": "port.input", "x": 1569.5487060546875, "y": 497.49131774902344, "name": "output-in", "alignment": "left", "parentNode": "f9e44988-31f0-4d4e-889c-166705cb456e", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}}}]}, "info": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "020c75b8-787c-4794-98cb-6bf9f189da1e", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "791px", "height": "300px"}}, "position": {"x": 520, "y": 173}}, {"id": "f9e44988-31f0-4d4e-889c-166705cb456e", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "4caadb3a-553d-47a6-aee3-ff9d658596c4", "port": "input-out", "name": "Enable"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Enable", "name": "Enable"}}, {"source": {"block": "020c75b8-787c-4794-98cb-6bf9f189da1e", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "3edd6ca5-d8ae-4255-9b66-3fcaeaee5a7e", "port": "Out", "name": "Out"}, "target": {"block": "f9e44988-31f0-4d4e-889c-166705cb456e", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}, "e64c0d6a-5b7e-431b-a9f7-a4580aed6d8c": {"id": "e64c0d6a-5b7e-431b-a9f7-a4580aed6d8c", "type": "block.package", "selected": false, "x": 101, "y": 162, "ports": [{"id": "f829d9e4-6373-41f9-84ab-01d92ed03c71", "type": "port.input", "x": 101.55382537841797, "y": 199.21876525878906, "name": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "alignment": "left", "parentNode": "e64c0d6a-5b7e-431b-a9f7-a4580aed6d8c", "links": ["4811b7f6-858d-4136-9064-299e1b6b149f"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "2777d7bf-cc33-4ccf-8824-aacec875202e", "type": "port.output", "x": 216.5538330078125, "y": 199.21876525878906, "name": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "alignment": "right", "parentNode": "e64c0d6a-5b7e-431b-a9f7-a4580aed6d8c", "links": ["ea499663-107e-4a4a-8a31-ac7000e03db9"], "in": false, "label": "Out", "hideLabel": false}], "data": {}, "model": {"id": "f2c89810-a9ca-49a6-9aaa-aff923b71c24", "locked": true, "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "1e8d9a20-c0fa-49ac-bf8f-e419eaf70280", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"fc46db03-af4c-4ee8-af3c-794247143848": {"id": "fc46db03-af4c-4ee8-af3c-794247143848", "type": "default", "selected": false, "source": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "sourcePort": "71d8c685-aacb-4f69-a283-c58fde872d90", "target": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "targetPort": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "points": [{"id": "b9a91cbe-0582-4a05-af85-1631ad55c0a4", "type": "point", "x": 462.0486454963684, "y": 439.9913487434387}, {"id": "2d3bba1b-31e9-4f13-ae62-045589d08428", "type": "point", "x": 528.0556035041809, "y": 547.1962132453918}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "dc56ba0a-7e88-486e-a516-60b4d2d2e47b": {"id": "dc56ba0a-7e88-486e-a516-60b4d2d2e47b", "type": "default", "selected": false, "source": "7f46902d-13d6-4284-84bd-3e51567ba674", "sourcePort": "b13c8c01-6787-41ce-a99b-510273e0574b", "target": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "targetPort": "d37fce43-929b-4e83-831c-7e98b9884cee", "points": [{"id": "7833c118-ea6f-4874-9b47-276723dec97e", "type": "point", "x": 689.5486454963684, "y": 120.9201512336731}, {"id": "dcb757de-4a4f-4cfa-8046-1e0a492e480c", "type": "point", "x": 982.5173954963684, "y": 249.86979722976685}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "4f38fd9d-8c95-4107-9711-cfd465e91876": {"id": "4f38fd9d-8c95-4107-9711-cfd465e91876", "type": "default", "selected": false, "source": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "sourcePort": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "target": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "targetPort": "365e60aa-68cf-46e1-ba34-84e48468aef9", "points": [{"id": "d0441376-29e4-4d5f-802f-47a607fb3801", "type": "point", "x": 1436.9879155158997, "y": 547.1962132453918}, {"id": "c8d318be-f218-4908-b74f-879d9da81883", "type": "point", "x": 1577.0487065315247, "y": 504.9913182258606}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "fcac3d46-b46f-4b24-9e41-e729de31940e", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"1ec59513-a92a-4d3f-8f44-5241f8acd5f4": {"id": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "type": "basic.input", "selected": false, "x": 369, "y": 414, "ports": [{"id": "71d8c685-aacb-4f69-a283-c58fde872d90", "type": "port.output", "x": 454.54864501953125, "y": 432.49134826660156, "name": "input-out", "alignment": "right", "parentNode": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "7f46902d-13d6-4284-84bd-3e51567ba674": {"id": "7f46902d-13d6-4284-84bd-3e51567ba674", "type": "basic.constant", "selected": false, "x": 629, "y": 6, "ports": [{"id": "b13c8c01-6787-41ce-a99b-510273e0574b", "type": "port.output", "x": 682.0486450195312, "y": 113.42015075683594, "name": "constant-out", "alignment": "bottom", "parentNode": "7f46902d-13d6-4284-84bd-3e51567ba674", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/odom", "local": true}}, "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36": {"id": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "type": "basic.code", "selected": false, "x": 520, "y": 173, "ports": [{"id": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "type": "port.input", "x": 520.5556030273438, "y": 539.6962127685547, "name": "Enable", "alignment": "left", "parentNode": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "type": "port.output", "x": 1429.4879150390625, "y": 539.6962127685547, "name": "Out", "alignment": "right", "parentNode": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": false, "label": "Out", "hideLabel": false}, {"id": "d37fce43-929b-4e83-831c-7e98b9884cee", "type": "port.parameter", "x": 975.0173950195312, "y": 242.3697967529297, "name": "ROSTopic", "alignment": "top", "parentNode": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\nimport math\nimport rclpy\nfrom rclpy.node import Node\nfrom nav_msgs.msg import Odometry\n\nrobot_pose = None\n\nclass OdomSubscriber(Node):\n    def __init__(self, topic):\n        super().__init__('odom_subscriber')\n        self.subscription = self.create_subscription(Odometry, topic, self.callback, 10)\n\n    def callback(self, msg):\n        global robot_pose\n        x = msg.pose.pose.position.x\n        y = msg.pose.pose.position.y\n        q = msg.pose.pose.orientation\n        siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)\n        cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n        yaw = math.atan2(siny_cosp, cosy_cosp)\n        robot_pose = [float(x), float(y), float(yaw)]\n\ndef main(inputs, outputs, parameters, synchronise):\n    global robot_pose\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    rclpy.init()\n    odom_sub = OdomSubscriber(parameters.read_string(\"ROSTopic\"))\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            robot_pose = None\n            rclpy.spin_once(odom_sub, timeout_sec=0)\n            if robot_pose is not None:\n                outputs.share_array(\"Out\", robot_pose)   \n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        odom_sub.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "791px", "height": "300px"}}}, "17b123b3-1dba-4db1-bd96-45a3abc64c76": {"id": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "type": "basic.output", "selected": false, "x": 1569, "y": 479, "ports": [{"id": "365e60aa-68cf-46e1-ba34-84e48468aef9", "type": "port.input", "x": 1569.5487060546875, "y": 497.49131774902344, "name": "output-in", "alignment": "left", "parentNode": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}}}]}, "info": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "7f46902d-13d6-4284-84bd-3e51567ba674", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/odom", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\nimport math\nimport rclpy\nfrom rclpy.node import Node\nfrom nav_msgs.msg import Odometry\n\nrobot_pose = None\n\nclass OdomSubscriber(Node):\n    def __init__(self, topic):\n        super().__init__('odom_subscriber')\n        self.subscription = self.create_subscription(Odometry, topic, self.callback, 10)\n\n    def callback(self, msg):\n        global robot_pose\n        x = msg.pose.pose.position.x\n        y = msg.pose.pose.position.y\n        q = msg.pose.pose.orientation\n        siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)\n        cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n        yaw = math.atan2(siny_cosp, cosy_cosp)\n        robot_pose = [float(x), float(y), float(yaw)]\n\ndef main(inputs, outputs, parameters, synchronise):\n    global robot_pose\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    rclpy.init()\n    odom_sub = OdomSubscriber(parameters.read_string(\"ROSTopic\"))\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            robot_pose = None\n            rclpy.spin_once(odom_sub, timeout_sec=0)\n            if robot_pose is not None:\n                outputs.share_array(\"Out\", robot_pose)   \n            synchronise()  \n    except Exception as e:\n        pass\n    finally:\n        synchronise()     \n        odom_sub.destroy_node()\n        rclpy.shutdown()", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "791px", "height": "300px"}}, "position": {"x": 520, "y": 173}}, {"id": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "1ec59513-a92a-4d3f-8f44-5241f8acd5f4", "port": "input-out", "name": "Enable"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Enable", "name": "Enable"}}, {"source": {"block": "7f46902d-13d6-4284-84bd-3e51567ba674", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "2e76d92d-4c70-43d4-a4d1-cb16cca0fc36", "port": "Out", "name": "Out"}, "target": {"block": "17b123b3-1dba-4db1-bd96-45a3abc64c76", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}, "c760ddae-6483-4eac-9961-f19ee2337c38": {"id": "c760ddae-6483-4eac-9961-f19ee2337c38", "type": "block.package", "selected": false, "x": 140, "y": 413, "ports": [{"id": "74744ea9-2d19-4784-a784-34d6c41ccd19", "type": "port.input", "x": 140.55555725097656, "y": 450.21702575683594, "name": "8b565109-2183-44da-a8e2-d5b3383f067f", "alignment": "left", "parentNode": "c760ddae-6483-4eac-9961-f19ee2337c38", "links": ["c00a0397-9596-4343-afa4-e8b108599b20"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "43bad4db-e456-41d8-8e1f-54d0da3a920f", "type": "port.output", "x": 255.55557250976562, "y": 450.21702575683594, "name": "dfbb0a58-dca9-4af2-