{"editor": {"id": "79eed146-2f11-4a75-a0f2-9f5b881ee5f9", "locked": false, "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "331227ea-b60f-4912-a826-2e33f1b4f42b", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"3ef54281-9938-4e37-b995-bf9537121342": {"id": "3ef54281-9938-4e37-b995-bf9537121342", "type": "default", "selected": false, "source": "7ed41c52-7c85-4f0b-bae1-e06d5b1286b7", "sourcePort": "7dcca1e9-d19d-4ed2-8d8b-5df295c59c49", "target": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "targetPort": "9161e0d7-93bc-4fc1-b192-8566c1260bfa", "points": [{"id": "283ae17f-6d16-4f27-a438-6d3763a6cdc8", "type": "point", "x": 257.04863023757935, "y": 337.7170262336731}, {"id": "eea9336f-c02b-4fc8-b997-928582c5ecdf", "type": "point", "x": 576.0503544807434, "y": 222.36979722976685}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "3578d625-0ece-4d64-ada1-bf65414aed6d": {"id": "3578d625-0ece-4d64-ada1-bf65414aed6d", "type": "default", "selected": false, "source": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "sourcePort": "3d27cb53-32c2-461a-ab3f-f1f0e62b8bb3", "target": "503b0d84-cb1e-4e67-bc0e-a19d147d2260", "targetPort": "d0d6eb4a-6a29-4871-becd-73fd81f1fdb5", "points": [{"id": "284877ec-5c21-4bbd-82ac-479cfba0f126", "type": "point", "x": 1062.1614995002747, "y": 313.53300523757935}, {"id": "25164254-41a0-4834-be12-91908b71be7f", "type": "point", "x": 1411.0504155158997, "y": 264.6093907356262}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "ea499663-107e-4a4a-8a31-ac7000e03db9": {"id": "ea499663-107e-4a4a-8a31-ac7000e03db9", "type": "default", "selected": false, "source": "e64c0d6a-5b7e-431b-a9f7-a4580aed6d8c", "sourcePort": "2777d7bf-cc33-4ccf-8824-aacec875202e", "target": "a3c5367d-f9fd-4d1f-955b-4421e0678db8", "targetPort": "5f22de7b-8e76-4663-b64c-662cf695e6e9", "points": [{"id": "4e3a30ba-5fe0-457a-bc5a-c06097b1c10e", "type": "