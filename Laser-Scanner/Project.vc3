rt": "b13c8c01-6787-41ce-a99b-510273e0574b", "target": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "targetPort": "d37fce43-929b-4e83-831c-7e98b9884cee", "points": [{"id": "7833c118-ea6f-4874-9b47-276723dec97e", "type": "point", "x": 689.619140625, "y": 120.849609375}, {"id": "dcb757de-4a4f-4cfa-8046-1e0a492e480c", "type": "point", "x": 982.587890625, "y": 250.3515625}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "4f38fd9d-8c95-4107-9711-cfd465e91876": {"id": "4f38fd9d-8c95-4107-9711-cfd465e91876", "type": "default", "selected": false, "source": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "sourcePort": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "target": "631c5fd0-f37e-4399-a121-4149f1c18f52", "targetPort": "365e60aa-68cf-46e1-ba34-84e48468aef9", "points": [{"id": "d0441376-29e4-4d5f-802f-47a607fb3801", "type": "point", "x": 1437.060546875, "y": 547.470703125}, {"id": "c8d318be-f218-4908-b74f-879d9da81883", "type": "point", "x": 1577.119140625, "y": 504.990234375}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "fcac3d46-b46f-4b24-9e41-e729de31940e", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"4ffa5ca3-9717-4ded-880d-75ee7b97d754": {"id": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "type": "basic.input", "selected": false, "x": 369, "y": 414, "ports": [{"id": "71d8c685-aacb-4f69-a283-c58fde872d90", "type": "port.output", "x": 454.619140625, "y": 432.490234375, "name": "input-out", "alignment": "right", "parentNode": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "9433ad75-6792-4c94-bd88-02f58d82e9d1": {"id": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "type": "basic.constant", "selected": false, "x": 629, "y": 6, "ports": [{"id": "b13c8c01-6787-41ce-a99b-510273e0574b", "type": "port.output", "x": 682.119140625, "y": 113.349609375, "name": "constant-out", "alignment": "bottom", "parentNode": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/scan", "local": true}}, "76ca99a4-8471-45fa-bdfd-c707db55b3e4": {"id": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "type": "basic.code", "selected": false, "x": 520, "y": 173, "ports": [{"id": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "type": "port.input", "x": 520.625, "y": 539.970703125, "name": "Enable", "alignment": "left", "parentNode": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "type": "port.output", "x": 1429.560546875, "y": 539.970703125, "name": "Out", "alignment": "right", "parentNode": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": false, "label": "Out", "hideLabel": false}, {"id": "d37fce43-929b-4e83-831c-7e98b9884cee", "type": "port.parameter", "x": 975.087890625, "y": 242.8515625, "name": "ROSTopic", "alignment": "top", "parentNode": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}}, "631c5fd0-f37e-4399-a121-4149f1c18f52": {"id": "631c5fd0-f37e-4399-a121-4149f1c18f52", "type": "basic.output", "selected": false, "x": 1569, "y": 479, "ports": [{"id": "365e60aa-68cf-46e1-ba34-84e48468aef9", "type": "port.input", "x": 1569.619140625, "y": 497.490234375, "name": "output-in", "alignment": "left", "parentNode": "631c5fd0-f37e-4399-a121-4149f1c18f52", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}}}]}, "info": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/scan", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}, "position": {"x": 520, "y": 173}}, {"id": "631c5fd0-f37e-4399-a121-4149f1c18f52", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "port": "input-out", "name": "Enable"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Enable", "name": "Enable"}}, {"source": {"block": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Out", "name": "Out"}, "target": {"block": "631c5fd0-f37e-4399-a121-4149f1c18f52", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}, "4a32c2ea-4ee3-4d9c-821d-43328c28286e": {"id": "4a32c2ea-4ee3-4d9c-821d-43328c28286e", "type": "block.package", "selected": false, "x": 1459, "y": 511, "ports": [{"id": "82a57a86-49da-45a3-8558-1daad4a86743", "type": "port.input", "x": 1459.619140625, "y": 527.451171875, "name": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "alignment": "left", "parentNode": "4a32c2ea-4ee3-4d9c-821d-43328c28286e", "links": ["5f266048-e6f9-422d-9091-276624b37c8c"], "in": true, "label": "Img", "hideLabel": false}, {"id": "74adacb8-b3f1-426d-82b2-70ae286e030e", "type": "port.input", "x": 1459.619140625, "y": 569.53125, "name": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "alignment": "left", "parentNode": "4a32c2ea-4ee3-4d9c-821d-43328c28286e", "links": ["ca2b95d2-e723-41a4-9086-cde90c478d7d"], "in": true, "label": "Enable", "hideLabel": false}], "data": {}, "model": {"id": "02d39dc9-90a5-4b7b-9593-ded395c6ffbd", "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "932f7358-1c6e-4a98-93bd-b2ee4131514e", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"c56e5714-b20f-4b79-ace1-28fa35ed3f90": {"id": "c56e5714-b20f-4b79-ace1-28fa35ed3f90", "type": "default", "selected": false, "source": "520ce479-8758-48f1-9f7f-08eeea72b200", "sourcePort": "e7fe7d26-b198-4e51-a49b-8c1402cb4259", "target": "459e9a36-7ed8-4147-abe6-aa1045d592b3", "targetPort": "42fe2618-2e3c-46f7-8993-4a866b056fb9", "points": [{"id": "b64bddde-e0c3-4012-a3bb-031170f7a7fe", "type": "point", "x": 354.5, "y": 230.80001831054688}, {"id": "e6112ace-5d4a-4e12-951d-bf6d0d42c575", "type": "point", "x": 546.5, "y": 314.20001220703125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "95534c5f-8370-4088-a25a-e86c7e77d757": {"id": "95534c5f-8370-4088-a25a-e86c7e77d757", "type": "default", "selected": false, "source": "405ebfde-eef2-436f-bd04-db1b79f5990e", "sourcePort": "e12385eb-5696-48ef-98bf-7576b69a165c", "target": "459e9a36-7ed8-4147-abe6-aa1045d592b3", "targetPort": "57c0f8c5-27bc-4745-9193-16dcbcf43291", "points": [{"id": "01552385-dcb7-4b14-8e94-0eaf41ab5bcc", "type": "point", "x": 364.5, "y": 477.79998779296875}, {"id": "ae45c292-a7c7-47c9-a946-1479a798578d", "type": "point", "x": 546.5, "y": 468.79998779296875}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "6215d446-3d7c-47f2-b8e8-6e0b93960d00", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"0ab8e809-8bf2-432f-8e48-f9eac93640d8": {"id": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "type": "basic.input", "selected": false, "x": 261, "y": 203, "ports": [{"id": "e7fe7d26-b198-4e51-a49b-8c1402cb4259", "type": "port.output", "x": 347, "y": 223.30001831054688, "name": "input-out", "alignment": "right", "parentNode": "520ce479-8758-48f1-9f7f-08eeea72b200", "links": ["c56e5714-b20f-4b79-ace1-28fa35ed3f90"], "in": false, "label": "Img", "hideLabel": true}], "data": {"name": "Img"}}, "ac90262c-593e-4090-8401-5abd9407b66f": {"id": "ac90262c-593e-4090-8401-5abd9407b66f", "type": "basic.code", "selected": false, "x": 538, "y": 110, "ports": [{"id": "42fe2618-2e3c-46f7-8993-4a866b056fb9", "type": "port.input", "x": 539, "y": 306.70001220703125, "name": "Img", "alignment": "left", "parentNode": "459e9a36-7ed8-4147-abe6-aa1045d592b3", "links": ["c56e5714-b20f-4b79-ace1-28fa35ed3f90"], "in": true, "label": "Img", "hideLabel": false}, {"id": "57c0f8c5-27bc-4745-9193-16dcbcf43291", "type": "port.input", "x": 539, "y": 461.29998779296875, "name": "Enable", "alignment": "left", "parentNode": "459e9a36-7ed8-4147-abe6-aa1045d592b3", "links": ["95534c5f-8370-4088-a25a-e86c7e77d757"], "in": true, "label": "Enable", "hideLabel": false}], "data": {"code": "import cv2\n\ndef main(inputs, outputs, parameters, synchronise):\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    while (auto_enable or inputs.read_number('Enable')):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        cv2.imshow(\"frame\", img)\n        cv2.waitKey(10)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": []}, "size": {"width": "744px", "height": "500px"}}}, "52bf5170-656d-4f57-a1a4-7ea30f5da014": {"id": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "type": "basic.input", "selected": false, "x": 271, "y": 450, "ports": [{"id": "e12385eb-5696-48ef-98bf-7576b69a165c", "type": "port.output", "x": 357, "y": 470.29998779296875, "name": "input-out", "alignment": "right", "parentNode": "405ebfde-eef2-436f-bd04-db1b79f5990e", "links": ["95534c5f-8370-4088-a25a-e86c7e77d757"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}}}]}, "info": {"name": "Screen", "version": "2.0.0", "description": "Displays Image or Video", "author": "Muhammad Taha Suhail, Suhas Gopal", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "type": "basic.input", "data": {"name": "Img"}, "position": {"x": 261, "y": 203}}, {"id": "ac90262c-593e-4090-8401-5abd9407b66f", "type": "basic.code", "data": {"code": "import cv2\n\ndef main(inputs, outputs, parameters, synchronise):\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    while (auto_enable or inputs.read_number('Enable')):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        cv2.imshow(\"frame\", img)\n        cv2.waitKey(10)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": []}, "size": {"width": "544px", "height": "19px"}}, "position": {"x": 538, "y": 110}}, {"id": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 271, "y": 450}}], "wires": [{"source": {"block": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "port": "input-out", "name": "Img"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Img", "name": "Img"}}, {"source": {"block": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "port": "input-out", "name": "Enable"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Enable", "name": "Enable"}}]}}, "dependencies": {}}, "ddca2f10-c83e-42ae-90a7-40d93f4f0476": {"id": "ddca2f10-c83e-42ae-90a7-40d93f4f0476", "type": "basic.code", "selected": false, "x": 246, "y": 486, "ports": [{"id": "f8c029e5-a76c-4a30-88ce-77c426c520f4", "type": "port.output", "x": 580.556640625, "y": 702.724609375, "name": "Odom", "alignment": "right", "parentNode": "ddca2f10-c83e-42ae-90a7-40d93f4f0476", "links": ["86be74af-bed8-4ef3-8661-47a57a70d091"], "in": false, "label": "Odom", "hideLabel": false}], "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom nav_msgs.msg import Odometry\nimport math\nimport threading\n\n# --- Global storage ---\nx, y, yaw = 0.0, 0.0, 0.0\n\ndef get_yaw(q):\n    \"\"\"Convert Quaternion to Yaw\"\"\"\n    t3 = +2.0 * (q.w * q.z + q.x * q.y)\n    t4 = +1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n    return math.atan2(t3, t4)\n\nclass OdomNode(Node):\n    def __init__(self, topic):\n        super().__init__('vc_odom_node')\n        self.sub = self.create_subscription(Odometry, topic, self.callback, 10)\n    def callback(self, msg):\n        global x, y, yaw\n        x = msg.pose.pose.position.x\n        y = msg.pose.pose.position.y\n        yaw = get_yaw(msg.pose.pose.orientation)\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok(): rclpy.init()\n    \n    # You can change the topic here if needed\n    node = OdomNode(\"/turtlebot3/odom\")\n    \n    # Run ROS 2 spin in background\n    thread = threading.Thread(target=rclpy.spin, args=(node, ), daemon=True)\n    thread.start()\n\n    while rclpy.ok():\n        # Output the pose array that the Brain block expects\n        outputs.write_array(\"Odom\", [x, y, 0.0, 0.0, 0.0, yaw])\n        synchronise()\n", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "Odom"}]}, "size": {"width": "405px", "height": "318px"}}}, "0011-3d634cc5-7143-4ab4-a581-41960f919d20": {"id": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "type": "basic.constant", "selected": false, "x": 611, "y": 74, "ports": [{"id": "041b949c-607b-48ca-baf2-bf86d3060502", "type": "port.output", "x": 664.12109375, "y": 181.34765625, "name": "constant-out", "alignment": "bottom", "parentNode": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "links": ["daebe334-356b-4280-b2a0-1ca9e7f81415", "8248a2d7-2345-4277-a5fe-112fc7f675eb", "ca2b95d2-e723-41a4-9086-cde90c478d7d"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable", "value": "1", "local": true}}}}]}, "version": "3.0", "package": {"name": "", "version": "", "description": "", "author": "", "image": ""}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "type": "basic.code", "data": {"code": "import numpy as np\nimport math\n\n# ==========================================\n# 1. HELPER CLASSES & FUNCTIONS\n# ==========================================\nclass RobotMapper:\n    def __init__(self):\n        # Local map storage\n        self.l_map = np.zeros((970, 1500), dtype=np.float32)\n        self.image_map = np.full((970, 1500), 128, dtype=np.uint8)\n        self.laser_angles = np.linspace(-math.pi/2, math.pi/2, 360)\n        \n    def bresenham_line(self, x0, y0, x1, y1):\n        points = []\n        dx, dy = abs(x1 - x0), abs(y1 - y0)\n        sx = 1 if x0 < x1 else -1\n        sy = 1 if y0 < y1 else -1\n        err = dx - dy\n        while True:\n            points.append((x0, y0))\n            if x0 == x1 and y0 == y1: break\n            e2 = 2 * err\n            if e2 > -dy: err -= dy; x0 += sx\n            if e2 < dx: err += dx; y0 += sy\n        return points\n\n    def update_map(self, px, py, pyaw, laser_scan):\n        # Convert World Coordinates to Pixel Coordinates\n        # (Assuming center of map 750,485 and 50px/meter scale)\n        r_x = int(750 + px * 50)\n        r_y = int(485 - py * 50)\n        \n        for i in range(0, len(laser_scan), 5): # Step by 5 for speed\n            dist = laser_scan[i]\n            if dist > 8.0 or dist < 0.1: continue\n\n            angle = pyaw + self.laser_angles[i % 360]\n            hx = int(750 + (px + dist * math.cos(angle)) * 50)\n            hy = int(485 - (py + dist * math.sin(angle)) * 50)\n\n            line = self.bresenham_line(r_x, r_y, hx, hy)\n            for (cx, cy) in line[:-1]:\n                if 0 <= cx < 1500 and 0 <= cy < 970:\n                    self.l_map[cy, cx] -= 0.2\n            if 0 <= hx < 1500 and 0 <= hy < 970:\n                self.l_map[hy, hx] += 0.5\n\n        np.clip(self.l_map, -5.0, 5.0, out=self.l_map)\n        self.image_map[:] = 128\n        self.image_map[self.l_map < -1.5] = 255 # Free\n        self.image_map[self.l_map > 1.5] = 0   # Occupied\n        return self.image_map\n\ndef normalize_angle(angle):\n    while angle > math.pi: angle -= 2 * math.pi\n    while angle < -math.pi: angle += 2 * math.pi\n    return angle\n\n# ==========================================\n# 2. MAIN BLOCK (VisualCircuit Entry Point)\n# ==========================================\ndef main(inputs, outputs, parameters, synchronise):\n    # --- PERSISTENT STATE (Defined once) ---\n    mapper = RobotMapper()\n    state = 0           # 0: FORWARD, 1: TURN1, 2: SHIFT, 3: TURN2\n    turn_dir = 1        # 1: LEFT, -1: RIGHT\n    target_yaw = 0.0    \n    timer = 0           \n    \n    # Tuning\n    FORWARD_SPEED = 0.4\n    TURN_SPEED = 0.3\n    WALL_DIST = 0.8\n    LANE_SHIFT_TICKS = 100 \n\n    print(\"Custom LawnMower Block Started...\")\n\n    while True:\n        # 1. READ INPUTS (From ROS2 Odometer & Laser blocks)\n        odom = inputs.read_array(\"Odom\")   # Format: [x, y, z, roll, pitch, yaw]\n        laser = inputs.read_array(\"Laser\") # Format: [ranges...]\n        \n        if odom is None or laser is None:\n            synchronise()\n            continue\n\n        px, py, pyaw = odom[0], odom[1], odom[5]\n        \n        # 2. MAPPING\n        map_img = mapper.update_map(px, py, pyaw, laser)\n        outputs.write_image(\"Map\", map_img)\n\n        # 3. NAVIGATION LOGIC (FSM)\n        # Check distance in front cone\n        front_cone = laser[0:15] + laser[-15:]\n        front_dist = min([d for d in front_cone if d > 0.1] or [10.0])\n        \n        v, w = 0.0, 0.0\n\n        if state == 0: # STATE_FORWARD\n            v, w = FORWARD_SPEED, 0.0\n            if front_dist < WALL_DIST:\n                state = 1\n                target_yaw = normalize_angle(pyaw + (turn_dir * math.radians(90)))\n        \n        elif state == 1: # STATE_TURN_1\n            err = normalize_angle(target_yaw - pyaw)\n            v, w = 0.0, (TURN_SPEED if err > 0 else -TURN_SPEED)\n            if abs(err) < 0.1:\n                state = 2\n                timer = LANE_SHIFT_TICKS\n        \n        elif state == 2: # STATE_SHIFT\n            v, w = FORWARD_SPEED, 0.0\n            timer -= 1\n            if timer <= 0:\n                state = 3\n                target_yaw = normalize_angle(pyaw + (turn_dir * math.radians(90)))\n        \n        elif state == 3: # STATE_TURN_2\n            err = normalize_angle(target_yaw - pyaw)\n            v, w = 0.0, (TURN_SPEED if err > 0 else -TURN_SPEED)\n            if abs(err) < 0.1:\n                state = 0\n                turn_dir *= -1 # Reverse turn direction for next wall\n\n        # 4. WRITE OUTPUTS\n        outputs.write_array(\"Vel\", [v, w])\n\n        # 5. SYNC\n        synchronise()\n", "frequency": "30", "params": [], "ports": {"in": [{"name": "Laser"}, {"name": "Odom"}], "out": [{"name": "Vel"}, {"name": "Map"}]}, "size": {"width": "405px", "height": "318px"}}, "position": {"x": 746, "y": 233}}, {"id": "3abcd114-3643-464a-91d4-c44430dd7a7b", "type": "5puEnPDscDtHyQAC0yke2UB8wudm4XVjswlsUw3g", "data": {}, "position": {"x": 1352, "y": 333}}, {"id": "8e9b3699-cb69-43cd-893e-caf0353ccec2", "type": "6MTMEMOUelpucM0ExAGdQjgJggy1nevrCYHUPv1J", "data": {}, "position": {"x": 412, "y": 331}}, {"id": "4a32c2ea-4ee3-4d9c-821d-43328c28286e", "type": "gEqmAsBIAXt7nobwOt3SyNpOdCGj6d5yuMJDmgey", "data": {}, "position": {"x": 1459, "y": 511}}, {"id": "ddca2f10-c83e-42ae-90a7-40d93f4f0476", "type": "basic.code", "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom nav_msgs.msg import Odometry\nimport math\nimport threading\n\n# --- Global storage ---\nx, y, yaw = 0.0, 0.0, 0.0\n\ndef get_yaw(q):\n    \"\"\"Convert Quaternion to Yaw\"\"\"\n    t3 = +2.0 * (q.w * q.z + q.x * q.y)\n    t4 = +1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n    return math.atan2(t3, t4)\n\nclass OdomNode(Node):\n    def __init__(self, topic):\n        super().__init__('vc_odom_node')\n        self.sub = self.create_subscription(Odometry, topic, self.callback, 10)\n    def callback(self, msg):\n        global x, y, yaw\n        x = msg.pose.pose.position.x\n        y = msg.pose.pose.position.y\n        yaw = get_yaw(msg.pose.pose.orientation)\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok(): rclpy.init()\n    \n    # You can change the topic here if needed\n    node = OdomNode(\"/turtlebot3/odom\")\n    \n    # Run ROS 2 spin in background\n    thread = threading.Thread(target=rclpy.spin, args=(node, ), daemon=True)\n    thread.start()\n\n    while rclpy.ok():\n        # Output the pose array that the Brain block expects\n        outputs.write_array(\"Odom\", [x, y, 0.0, 0.0, 0.0, yaw])\n        synchronise()\n", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "Odom"}]}, "size": {"width": "405px", "height": "318px"}}, "position": {"x": 246, "y": 486}}, {"id": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "type": "basic.constant", "data": {"name": "Enable", "value": "1", "local": true}, "position": {"x": 611, "y": 74}}], "wires": [{"source": {"block": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "port": "Vel", "name": "Vel"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Vels", "name": "Vels"}}, {"source": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Out", "name": "Out"}, "target": {"block": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "port": "Laser", "name": "Laser"}}, {"source": {"block": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "port": "Map", "name": "Map"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Img", "name": "Img"}}, {"source": {"block": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "port": "constant-out", "name": "Enable"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Enable", "name": "Enable"}}, {"source": {"block": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "port": "constant-out", "name": "Enable"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Enable", "name": "Enable"}}, {"source": {"block": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "port": "constant-out", "name": "Enable"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Enable", "name": "Enable"}}, {"source": {"block": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "port": "input-out", "name": "Vels", "ob": "absent"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Vels", "name": "Vels"}}, {"source": {"block": "d6685abe-033b-4799-b351-edd5247a7ed7", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Enable", "name": "Enable"}}, {"source": {"block": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Enable", "name": "Enable"}}, {"source": {"block": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Out", "name": "Out"}, "target": {"block": "631c5fd0-f37e-4399-a121-4149f1c18f52", "port": "output-in", "name": "output-in", "ob": "absent"}}, {"source": {"block": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "port": "input-out", "name": "Img", "ob": "absent"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Img", "name": "Img"}}, {"source": {"block": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Enable", "name": "Enable"}}]}}, "dependencies": {"5puEnPDscDtHyQAC0yke2UB8wudm4XVjswlsUw3g": {"package": {"name": "ROS2MotorDriver", "version": "1.0.0", "description": "Controls Robot's Movement using ROS2.", "author": "David Tapiador de Vera", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "type": "basic.input", "data": {"name": "Vels"}, "position": {"x": 95, "y": 232}}, {"id": "d6685abe-033b-4799-b351-edd5247a7ed7", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 99, "y": 338}}, {"id": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\n\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom geometry_msgs.msg import Twist\n\nbridge = CvBridge()\nvelocities = 0\n\n# ros2 node class\nclass VelPublisher(Node):\n\n    def __init__(self, topic):\n        super().__init__('vel_publisher')\n        self.publisher_ = self.create_publisher(Twist, topic, 1)\n        timer_period = 0.5  # seconds\n        self.timer = self.create_timer(timer_period, self.timer_callback)\n\n    def timer_callback(self):\n        global velocities\n        msg = Twist()\n        \n        try:\n            msg.linear.x = float(velocities[0])\n            msg.linear.y = float(velocities[1])\n            msg.linear.z = float(velocities[2])\n            msg.angular.x = float(velocities[3])\n            msg.angular.y = float(velocities[4])\n            msg.angular.z = float(velocities[5])\n        except IndexError:\n            print(\"bad length for input array\")\n            return\n        self.publisher_.publish(msg)\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global velocities\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    vel_publisher = VelPublisher(parameters.read_string('ROSTopic'))\n\n    try:\n\n        while auto_enable or inputs.read_number('Enable'):\n\n            velocities = inputs.read_array('Vels')\n            if velocities is not None:\n                rclpy.spin_once(vel_publisher) \n            synchronise()   \n    \n    except KeyboardInterrupt:\n\n        vel_publisher.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Vels"}, {"name": "Enable"}], "out": []}, "size": {"width": "988px", "height": "585px"}}, "position": {"x": 369, "y": 65}}, {"id": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/cmd_vel", "local": true}, "position": {"x": 803, "y": -78}}], "wires": [{"source": {"block": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "port": "input-out", "name": "Vels", "ob": "absent"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Vels", "name": "Vels"}}, {"source": {"block": "d6685abe-033b-4799-b351-edd5247a7ed7", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Enable", "name": "Enable"}}, {"source": {"block": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "ROSTopic", "name": "ROSTopic"}}]}}, "dependencies": {}}, "6MTMEMOUelpucM0ExAGdQjgJggy1nevrCYHUPv1J": {"package": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/scan", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}, "position": {"x": 520, "y": 173}}, {"id": "631c5fd0-f37e-4399-a121-4149f1c18f52", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "4ffa5ca3-9717-4ded-880d-75ee7b97d754", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Enable", "name": "Enable"}}, {"source": {"block": "9433ad75-6792-4c94-bd88-02f58d82e9d1", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "76ca99a4-8471-45fa-bdfd-c707db55b3e4", "port": "Out", "name": "Out"}, "target": {"block": "631c5fd0-f37e-4399-a121-4149f1c18f52", "port": "output-in", "name": "output-in", "ob": "absent"}}]}}, "dependencies": {}}, "gEqmAsBIAXt7nobwOt3SyNpOdCGj6d5yuMJDmgey": {"package": {"name": "Screen", "version": "2.0.0", "description": "Displays Image or Video", "author": "Muhammad Taha Suhail, Suhas Gopal", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "type": "basic.input", "data": {"name": "Img"}, "position": {"x": 261, "y": 203}}, {"id": "ac90262c-593e-4090-8401-5abd9407b66f", "type": "basic.code", "data": {"code": "import cv2\n\ndef main(inputs, outputs, parameters, synchronise):\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n    while (auto_enable or inputs.read_number('Enable')):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        cv2.imshow(\"frame\", img)\n        cv2.waitKey(10)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": []}, "size": {"width": "544px", "height": "19px"}}, "position": {"x": 538, "y": 110}}, {"id": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 271, "y": 450}}], "wires": [{"source": {"block": "0ab8e809-8bf2-432f-8e48-f9eac93640d8", "port": "input-out", "name": "Img", "ob": "absent"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Img", "name": "Img"}}, {"source": {"block": "52bf5170-656d-4f57-a1a4-7ea30f5da014", "port": "input-out", "name": "Enable", "ob": "absent"}, "target": {"block": "ac90262c-593e-4090-8401-5abd9407b66f", "port": "Enable", "name": "Enable"}}]}}, "dependencies": {}}}}