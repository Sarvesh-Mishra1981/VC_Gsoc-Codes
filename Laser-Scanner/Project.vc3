{"editor": {"id": "e86c0dfa-816d-4ec8-9d6a-09368a976822", "locked": false, "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "bb954a7a-36a1-477a-9520-a95487f22ac0", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"fb0f811f-8327-45d9-aff6-53d7144f9622": {"id": "fb0f811f-8327-45d9-aff6-53d7144f9622", "type": "default", "selected": false, "source": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "sourcePort": "2e1fd281-5a33-4457-8ee8-b411c7cf6463", "target": "3abcd114-3643-464a-91d4-c44430dd7a7b", "targetPort": "698f7c8f-18bc-4343-99df-657089b8e774", "points": [{"id": "972bb7a6-7caf-4e53-9c64-71012bd994ea", "type": "point", "x": 1213.76953125, "y": 405.517578125}, {"id": "c43f5d70-4352-4c28-9fae-8f7ad5248abe", "type": "point", "x": 1360.1171875, "y": 356.953125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "5a63c826-a1ba-4363-8cd1-e18af03a2fb8": {"id": "5a63c826-a1ba-4363-8cd1-e18af03a2fb8", "type": "default", "selected": false, "source": "8e9b3699-cb69-43cd-893e-caf0353ccec2", "sourcePort": "00021a39-dbdf-42dc-8192-bdf4a9cb6b4a", "target": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "targetPort": "3f216278-4d4f-46d3-8fc0-7f93cb5091b6", "points": [{"id": "2fb4f659-9e4e-4e3a-8b4e-239f11c6871e", "type": "point", "x": 535.1171875, "y": 375.99609375}, {"id": "3bdd5455-916a-4aba-82b3-571545aa161c", "type": "point", "x": 754.12109375, "y": 405.517578125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "5f266048-e6f9-422d-9091-276624b37c8c": {"id": "5f266048-e6f9-422d-9091-276624b37c8c", "type": "default", "selected": false, "source": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "sourcePort": "5e35c118-c2e0-4a71-bfbd-f18565ea9295", "target": "4a32c2ea-4ee3-4d9c-821d-43328c28286e", "targetPort": "82a57a86-49da-45a3-8558-1daad4a86743", "points": [{"id": "8dda7841-4675-4912-91b7-39998840d1d3", "type": "point", "x": 1213.76953125, "y": 526.93359375}, {"id": "44c0490b-7206-429f-9de0-0acbccb40cf5", "type": "point", "x": 1467.119140625, "y": 534.951171875}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "86be74af-bed8-4ef3-8661-47a57a70d091": {"id": "86be74af-bed8-4ef3-8661-47a57a70d091", "type": "default", "selected": false, "source": "ddca2f10-c83e-42ae-90a7-40d93f4f0476", "sourcePort": "f8c029e5-a76c-4a30-88ce-77c426c520f4", "target": null, "targetPort": null, "points": [{"id": "c0198eb4-90e9-411a-892a-20d03a9dad63", "type": "point", "x": 588.056640625, "y": 710.224609375}, {"id": "ebec3352-6838-4549-a3f2-be8c2f1b4a54", "type": "point", "x": 751, "y": 525.005859375}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "daebe334-356b-4280-b2a0-1ca9e7f81415": {"id": "daebe334-356b-4280-b2a0-1ca9e7f81415", "type": "default", "selected": false, "source": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "sourcePort": "041b949c-607b-48ca-baf2-bf86d3060502", "target": "8e9b3699-cb69-43cd-893e-caf0353ccec2", "targetPort": "b3f289f7-bd86-49f4-a0c3-d6ace1acbad0", "points": [{"id": "b083d074-1fc3-4ae8-b903-3429d5f0ed48", "type": "point", "x": 671.62109375, "y": 188.84765625}, {"id": "40ed247d-a253-41e3-88bb-63c5a541c2b2", "type": "point", "x": 420.1171875, "y": 375.99609375}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "8248a2d7-2345-4277-a5fe-112fc7f675eb": {"id": "8248a2d7-2345-4277-a5fe-112fc7f675eb", "type": "default", "selected": false, "source": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "sourcePort": "041b949c-607b-48ca-baf2-bf86d3060502", "target": "3abcd114-3643-464a-91d4-c44430dd7a7b", "targetPort": "7d9e9c9a-d915-400b-8707-216e6bf40d2c", "points": [{"id": "2e03a1ef-3e10-47cf-ac7c-a27e77785973", "type": "point", "x": 671.62109375, "y": 188.84765625}, {"id": "ac8cd3a5-e0a7-4547-bb46-11176528fa7d", "type": "point", "x": 1360.1171875, "y": 399.033203125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "ca2b95d2-e723-41a4-9086-cde90c478d7d": {"id": "ca2b95d2-e723-41a4-9086-cde90c478d7d", "type": "default", "selected": false, "source": "0011-3d634cc5-7143-4ab4-a581-41960f919d20", "sourcePort": "041b949c-607b-48ca-baf2-bf86d3060502", "target": "4a32c2ea-4ee3-4d9c-821d-43328c28286e", "targetPort": "74adacb8-b3f1-426d-82b2-70ae286e030e", "points": [{"id": "4eab8539-0a16-4086-b5f9-48aeede21e07", "type": "point", "x": 671.62109375, "y": 188.84765625}, {"id": "43e24103-0fce-4ebc-bf07-957a52012461", "type": "point", "x": 1467.119140625, "y": 577.03125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "4be4df16-cf8e-4230-b3be-acd8c6442c23", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"a2e8cede-ff05-4d7a-84b6-ecc8ae330350": {"id": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "type": "basic.code", "selected": false, "x": 746, "y": 233, "ports": [{"id": "3f216278-4d4f-46d3-8fc0-7f93cb5091b6", "type": "port.input", "x": 746.62109375, "y": 398.017578125, "name": "Laser", "alignment": "left", "parentNode": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "links": ["5a63c826-a1ba-4363-8cd1-e18af03a2fb8"], "in": true, "label": "Laser", "hideLabel": false}, {"id": "ca01a5c2-682b-41eb-9ed1-f9c62ba44ac0", "type": "port.input", "x": 746.62109375, "y": 519.43359375, "name": "Odom", "alignment": "left", "parentNode": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "links": [], "in": true, "label": "Odom", "hideLabel": false}, {"id": "2e1fd281-5a33-4457-8ee8-b411c7cf6463", "type": "port.output", "x": 1206.26953125, "y": 398.017578125, "name": "Vel", "alignment": "right", "parentNode": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "links": ["fb0f811f-8327-45d9-aff6-53d7144f9622"], "in": false, "label": "Vel", "hideLabel": false}, {"id": "5e35c118-c2e0-4a71-bfbd-f18565ea9295", "type": "port.output", "x": 1206.26953125, "y": 519.43359375, "name": "Map", "alignment": "right", "parentNode": "a2e8cede-ff05-4d7a-84b6-ecc8ae330350", "links": ["5f266048-e6f9-422d-9091-276624b37c8c"], "in": false, "label": "Map", "hideLabel": false}], "data": {"code": "import numpy as np\nimport math\n\n# ==========================================\n# 1. HELPER CLASSES & FUNCTIONS\n# ==========================================\nclass RobotMapper:\n    def __init__(self):\n        # Local map storage\n        self.l_map = np.zeros((970, 1500), dtype=np.float32)\n        self.image_map = np.full((970, 1500), 128, dtype=np.uint8)\n        self.laser_angles = np.linspace(-math.pi/2, math.pi/2, 360)\n        \n    def bresenham_line(self, x0, y0, x1, y1):\n        points = []\n        dx, dy = abs(x1 - x0), abs(y1 - y0)\n        sx = 1 if x0 < x1 else -1\n        sy = 1 if y0 < y1 else -1\n        err = dx - dy\n        while True:\n            points.append((x0, y0))\n            if x0 == x1 and y0 == y1: break\n            e2 = 2 * err\n            if e2 > -dy: err -= dy; x0 += sx\n            if e2 < dx: err += dx; y0 += sy\n        return points\n\n    def update_map(self, px, py, pyaw, laser_scan):\n        # Convert World Coordinates to Pixel Coordinates\n        # (Assuming center of map 750,485 and 50px/meter scale)\n        r_x = int(750 + px * 50)\n        r_y = int(485 - py * 50)\n        \n        for i in range(0, len(laser_scan), 5): # Step by 5 for speed\n            dist = laser_scan[i]\n            if dist > 8.0 or dist < 0.1: continue\n\n            angle = pyaw + self.laser_angles[i % 360]\n            hx = int(750 + (px + dist * math.cos(angle)) * 50)\n            hy = int(485 - (py + dist * math.sin(angle)) * 50)\n\n            line = self.bresenham_line(r_x, r_y, hx, hy)\n            for (cx, cy) in line[:-1]:\n                if 0 <= cx < 1500 and 0 <= cy < 970:\n                    self.l_map[cy, cx] -= 0.2\n            if 0 <= hx < 1500 and 0 <= hy < 970:\n                self.l_map[hy, hx] += 0.5\n\n        np.clip(self.l_map, -5.0, 5.0, out=self.l_map)\n        self.image_map[:] = 128\n        self.image_map[self.l_map < -1.5] = 255 # Free\n        self.image_map[self.l_map > 1.5] = 0   # Occupied\n        return self.image_map\n\ndef normalize_angle(angle):\n    while angle > math.pi: angle -= 2 * math.pi\n    while angle < -math.pi: angle += 2 * math.pi\n    return angle\n\n# ==========================================\n# 2. MAIN BLOCK (VisualCircuit Entry Point)\n# ==========================================\ndef main(inputs, outputs, parameters, synchronise):\n    # --- PERSISTENT STATE (Defined once) ---\n    mapper = RobotMapper()\n    state = 0           # 0: FORWARD, 1: TURN1, 2: SHIFT, 3: TURN2\n    turn_dir = 1        # 1: LEFT, -1: RIGHT\n    target_yaw = 0.0    \n    timer = 0           \n    \n    # Tuning\n    FORWARD_SPEED = 0.4\n    TURN_SPEED = 0.3\n    WALL_DIST = 0.8\n    LANE_SHIFT_TICKS = 100 \n\n    print(\"Custom LawnMower Block Started...\")\n\n    while True:\n        # 1. READ INPUTS (From ROS2 Odometer & Laser blocks)\n        odom = inputs.read_array(\"Odom\")   # Format: [x, y, z, roll, pitch, yaw]\n        laser = inputs.read_array(\"Laser\") # Format: [ranges...]\n        \n        if odom is None or laser is None:\n            synchronise()\n            continue\n\n        px, py, pyaw = odom[0], odom[1], odom[5]\n        \n        # 2. MAPPING\n        map_img = mapper.update_map(px, py, pyaw, laser)\n        outputs.write_image(\"Map\", map_img)\n\n        # 3. NAVIGATION LOGIC (FSM)\n        # Check distance in front cone\n        front_cone = laser[0:15] + laser[-15:]\n        front_dist = min([d for d in front_cone if d > 0.1] or [10.0])\n        \n        v, w = 0.0, 0.0\n\n        if state == 0: # STATE_FORWARD\n            v, w = FORWARD_SPEED, 0.0\n            if front_dist < WALL_DIST:\n                state = 1\n                target_yaw = normalize_angle(pyaw + (turn_dir * math.radians(90)))\n        \n        elif state == 1: # STATE_TURN_1\n            err = normalize_angle(target_yaw - pyaw)\n            v, w = 0.0, (TURN_SPEED if err > 0 else -TURN_SPEED)\n            if abs(err) < 0.1:\n                state = 2\n                timer = LANE_SHIFT_TICKS\n        \n        elif state == 2: # STATE_SHIFT\n            v, w = FORWARD_SPEED, 0.0\n            timer -= 1\n            if timer <= 0:\n                state = 3\n                target_yaw = normalize_angle(pyaw + (turn_dir * math.radians(90)))\n        \n        elif state == 3: # STATE_TURN_2\n            err = normalize_angle(target_yaw - pyaw)\n            v, w = 0.0, (TURN_SPEED if err > 0 else -TURN_SPEED)\n            if abs(err) < 0.1:\n                state = 0\n                turn_dir *= -1 # Reverse turn direction for next wall\n\n        # 4. WRITE OUTPUTS\n        outputs.write_array(\"Vel\", [v, w])\n\n        # 5. SYNC\n        synchronise()\n", "frequency": "30", "params": [], "ports": {"in": [{"name": "Laser"}, {"name": "Odom"}], "out": [{"name": "Vel"}, {"name": "Map"}]}, "size": {"width": "405px", "height": "318px"}}}, "3abcd114-3643-464a-91d4-c44430dd7a7b": {"id": "3abcd114-3643-464a-91d4-c44430dd7a7b", "type": "block.package", "selected": false, "x": 1352, "y": 333, "ports": [{"id": "698f7c8f-18bc-4343-99df-657089b8e774", "type": "port.input", "x": 1352.6171875, "y": 349.453125, "name": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "alignment": "left", "parentNode": "3abcd114-3643-464a-91d4-c44430dd7a7b", "links": ["fb0f811f-8327-45d9-aff6-53d7144f9622"], "in": true, "label": "Vels", "hideLabel": false}, {"id": "7d9e9c9a-d915-400b-8707-216e6bf40d2c", "type": "port.input", "x": 1352.6171875, "y": 391.533203125, "name": "d6685abe-033b-4799-b351-edd5247a7ed7", "alignment": "left", "parentNode": "3abcd114-3643-464a-91d4-c44430dd7a7b", "links": ["8248a2d7-2345-4277-a5fe-112fc7f675eb"], "in": true, "label": "Enable", "hideLabel": false}], "data": {}, "model": {"id": "bb24521a-8c41-4f55-8e96-b7aff41c4297", "locked": true, "offsetX": 35, "offsetY": 98, "zoom": 100, "gridSize": 0, "layers": [{"id": "50937002-f39a-4d49-a9eb-39771635497f", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"1e2cd58f-7aae-41e9-bfbb-777e1296b017": {"id": "1e2cd58f-7aae-41e9-bfbb-777e1296b017", "type": "default", "selected": false, "source": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "sourcePort": "a23d135a-c5ad-4eac-8978-9c8fdae27da3", "target": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "targetPort": "85b9140d-79ee-46ae-942e-f103dfe70aae", "points": [{"id": "7b0064bc-9032-4093-9745-1b9add0d01ce", "type": "point", "x": 188.125, "y": 257.98828125}, {"id": "c7264bba-cc90-4fb5-82e7-270afc776544", "type": "point", "x": 377.744140625, "y": 353.388671875}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "f13df527-0eea-46a7-ba57-c8967f56a2d6": {"id": "f13df527-0eea-46a7-ba57-c8967f56a2d6", "type": "default", "selected": false, "source": "d6685abe-033b-4799-b351-edd5247a7ed7", "sourcePort": "80c09fc1-951c-412b-8395-f298f56faf68", "target": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "targetPort": "424fe5f3-8908-46b3-81f2-47e3b7acd14f", "points": [{"id": "50a22531-04b5-408c-8805-3d9f8bad3982", "type": "point", "x": 192.119140625, "y": 363.994140625}, {"id": "aa570841-6125-4a9d-97c3-68476d81013e", "type": "point", "x": 377.744140625, "y": 563.80859375}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "3ff23423-89db-4495-bc80-ec747b014e77": {"id": "3ff23423-89db-4495-bc80-ec747b014e77", "type": "default", "selected": false, "source": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "sourcePort": "a6d95f72-926d-4334-9737-9b6e9b4206c0", "target": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "targetPort": "42dddbf9-3f8e-45b9-8a50-7ba984f72abf", "points": [{"id": "e517fdd6-87e8-44b6-80d9-8f6da0b71dbe", "type": "point", "x": 863.623046875, "y": 36.85546875}, {"id": "70c6e2da-8e29-486a-a19d-25fcfad41f8b", "type": "point", "x": 890.439453125, "y": 142.978515625}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "220b70ae-199a-4bc2-8a5d-05e7ec6ae5ca", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"53d6c09a-2815-45cf-b3de-36e6b5de5139": {"id": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "type": "basic.input", "selected": false, "x": 95, "y": 232, "ports": [{"id": "a23d135a-c5ad-4eac-8978-9c8fdae27da3", "type": "port.output", "x": 180.625, "y": 250.48828125, "name": "input-out", "alignment": "right", "parentNode": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "links": ["1e2cd58f-7aae-41e9-bfbb-777e1296b017"], "in": false, "label": "Vels", "hideLabel": true}], "data": {"name": "Vels"}}, "d6685abe-033b-4799-b351-edd5247a7ed7": {"id": "d6685abe-033b-4799-b351-edd5247a7ed7", "type": "basic.input", "selected": false, "x": 99, "y": 338, "ports": [{"id": "80c09fc1-951c-412b-8395-f298f56faf68", "type": "port.output", "x": 184.619140625, "y": 356.494140625, "name": "input-out", "alignment": "right", "parentNode": "d6685abe-033b-4799-b351-edd5247a7ed7", "links": ["f13df527-0eea-46a7-ba57-c8967f56a2d6"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "bf9293ed-9409-40d2-b3c1-2c65949dc3c2": {"id": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "type": "basic.code", "selected": true, "x": 369, "y": 65, "ports": [{"id": "85b9140d-79ee-46ae-942e-f103dfe70aae", "type": "port.input", "x": 370.244140625, "y": 345.888671875, "name": "Vels", "alignment": "left", "parentNode": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "links": ["1e2cd58f-7aae-41e9-bfbb-777e1296b017"], "in": true, "label": "Vels", "hideLabel": false}, {"id": "424fe5f3-8908-46b3-81f2-47e3b7acd14f", "type": "port.input", "x": 370.244140625, "y": 556.30859375, "name": "Enable", "alignment": "left", "parentNode": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "links": ["f13df527-0eea-46a7-ba57-c8967f56a2d6"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "42dddbf9-3f8e-45b9-8a50-7ba984f72abf", "type": "port.parameter", "x": 882.939453125, "y": 135.478515625, "name": "ROSTopic", "alignment": "top", "parentNode": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "links": ["3ff23423-89db-4495-bc80-ec747b014e77"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\n\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom geometry_msgs.msg import Twist\n\nbridge = CvBridge()\nvelocities = 0\n\n# ros2 node class\nclass VelPublisher(Node):\n\n    def __init__(self, topic):\n        super().__init__('vel_publisher')\n        self.publisher_ = self.create_publisher(Twist, topic, 1)\n        timer_period = 0.5  # seconds\n        self.timer = self.create_timer(timer_period, self.timer_callback)\n\n    def timer_callback(self):\n        global velocities\n        msg = Twist()\n        \n        try:\n            msg.linear.x = float(velocities[0])\n            msg.linear.y = float(velocities[1])\n            msg.linear.z = float(velocities[2])\n            msg.angular.x = float(velocities[3])\n            msg.angular.y = float(velocities[4])\n            msg.angular.z = float(velocities[5])\n        except IndexError:\n            print(\"bad length for input array\")\n            return\n        self.publisher_.publish(msg)\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global velocities\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    vel_publisher = VelPublisher(parameters.read_string('ROSTopic'))\n\n    try:\n\n        while auto_enable or inputs.read_number('Enable'):\n\n            velocities = inputs.read_array('Vels')\n            if velocities is not None:\n                rclpy.spin_once(vel_publisher) \n            synchronise()   \n    \n    except KeyboardInterrupt:\n\n        vel_publisher.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Vels"}, {"name": "Enable"}], "out": []}, "size": {"width": "988px", "height": "585px"}}}, "aabc075c-fbfa-4504-9ce3-9c017ceb104a": {"id": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "type": "basic.constant", "selected": false, "x": 803, "y": -78, "ports": [{"id": "a6d95f72-926d-4334-9737-9b6e9b4206c0", "type": "port.output", "x": 856.123046875, "y": 29.35546875, "name": "constant-out", "alignment": "bottom", "parentNode": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "links": ["3ff23423-89db-4495-bc80-ec747b014e77"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/cmd_vel", "local": true}}}}]}, "info": {"name": "ROS2MotorDriver", "version": "1.0.0", "description": "Controls Robot's Movement using ROS2.", "author": "David Tapiador de Vera", "image": "data:image/svg+xml;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "type": "basic.input", "data": {"name": "Vels"}, "position": {"x": 95, "y": 232}}, {"id": "d6685abe-033b-4799-b351-edd5247a7ed7", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 99, "y": 338}}, {"id": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\n\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom geometry_msgs.msg import Twist\n\nbridge = CvBridge()\nvelocities = 0\n\n# ros2 node class\nclass VelPublisher(Node):\n\n    def __init__(self, topic):\n        super().__init__('vel_publisher')\n        self.publisher_ = self.create_publisher(Twist, topic, 1)\n        timer_period = 0.5  # seconds\n        self.timer = self.create_timer(timer_period, self.timer_callback)\n\n    def timer_callback(self):\n        global velocities\n        msg = Twist()\n        \n        try:\n            msg.linear.x = float(velocities[0])\n            msg.linear.y = float(velocities[1])\n            msg.linear.z = float(velocities[2])\n            msg.angular.x = float(velocities[3])\n            msg.angular.y = float(velocities[4])\n            msg.angular.z = float(velocities[5])\n        except IndexError:\n            print(\"bad length for input array\")\n            return\n        self.publisher_.publish(msg)\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global velocities\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    vel_publisher = VelPublisher(parameters.read_string('ROSTopic'))\n\n    try:\n\n        while auto_enable or inputs.read_number('Enable'):\n\n            velocities = inputs.read_array('Vels')\n            if velocities is not None:\n                rclpy.spin_once(vel_publisher) \n            synchronise()   \n    \n    except KeyboardInterrupt:\n\n        vel_publisher.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Vels"}, {"name": "Enable"}], "out": []}, "size": {"width": "988px", "height": "585px"}}, "position": {"x": 369, "y": 65}}, {"id": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/cmd_vel", "local": true}, "position": {"x": 803, "y": -78}}], "wires": [{"source": {"block": "53d6c09a-2815-45cf-b3de-36e6b5de5139", "port": "input-out", "name": "Vels"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Vels", "name": "Vels"}}, {"source": {"block": "d6685abe-033b-4799-b351-edd5247a7ed7", "port": "input-out", "name": "Enable"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c65949dc3c2", "port": "Enable", "name": "Enable"}}, {"source": {"block": "aabc075c-fbfa-4504-9ce3-9c017ceb104a", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "bf9293ed-9409-40d2-b3c1-2c6594