{"editor": {"id": "de9153de-c4af-4fb5-94b6-fe59fe1e148e", "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "b7d922dc-489a-4771-9d31-a6b9cde95855", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"e63e9331-a536-4654-a550-457d11eacdbd": {"id": "e63e9331-a536-4654-a550-457d11eacdbd", "type": "default", "selected": false, "source": "48cdb8f9-e7dc-4e20-ac70-33a8a47c8e54", "sourcePort": "662dad3a-78d0-4ae9-ba67-a12cf0716932", "target": "13b27369-710f-4ab3-9855-73a66f2085b4", "targetPort": "447e2ac4-5080-4639-9f26-8c8144c6fcf7", "points": [{"id": "a2c61a59-9db3-450b-b581-ebcd023f9412", "type": "point", "x": 463.0555729866028, "y": 214.86979722976685}, {"id": "4e5b7813-6e61-499c-8d0a-7d859ef43d53", "type": "point", "x": 530.0521245002747, "y": 212.8646092414856}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "3e63a69f-c843-407c-a62e-bd6dd4b16fe2": {"id": "3e63a69f-c843-407c-a62e-bd6dd4b16fe2", "type": "default", "selected": false, "source": "48cdb8f9-e7dc-4e20-ac70-33a8a47c8e54", "sourcePort": "f1dc2516-a85a-40e9-9464-e0fad23b3f2a", "target": "13b27369-710f-4ab3-9855-73a66f2085b4", "targetPort": "a04b4a68-334c-4c43-bcbc-1e7a9ae378a0", "points": [{"id": "0d01481d-7227-4058-ae60-6ad5bbd37227", "type": "point", "x": 463.0555729866028, "y": 291.20661973953247}, {"id": "601e97be-4d39-459b-bf29-c13bd60d394c", "type": "point", "x": 530.0521245002747, "y": 289.2014012336731}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "d9d7b09f-2e7b-44f7-8418-689614aecc64": {"id": "d9d7b09f-2e7b-44f7-8418-689614aecc64", "type": "default", "selected": false, "source": "48cdb8f9-e7dc-4e20-ac70-33a8a47c8e54", "sourcePort": "03ce72c7-b73b-492a-8947-75d7aca607b1", "target": "13b27369-710f-4ab3-9855-73a66f2085b4", "targetPort": "f7db3299-bbda-4044-9222-663d2bd49ac9", "points": [{"id": "8273ad92-ba04-4c89-bbcd-11ebee95ec79", "type": "point", "x": 463.055