{"editor": {"id": "05060e9e-5f78-401d-8e0f-58720b35a842", "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "ec0148b9-1a9b-4ef9-bc47-54de82df0d00", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"3bb3c223-3542-4dee-9466-f0b5a178a754": {"id": "3bb3c223-3542-4dee-9466-f0b5a178a754", "type": "default", "selected": false, "source": "6091aa26-60f8-4e7f-83c6-5966629f63b0", "sourcePort": "ff1372fc-8658-419d-854e-036acb41e37c", "target": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "targetPort": "6c00d13e-20e2-4b9e-ae78-b2ffa8edc918", "points": [{"id": "b1d21760-0f28-4114-a547-e96aa882e0f7", "type": "point", "x": 463.0555729866028, "y": 317.7083592414856}, {"id": "160ede95-43b2-4e08-b7e8-b2530c122c56", "type": "point", "x": 475.05209398269653, "y": 315.7031407356262}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "1a817a44-fe12-4146-bea5-8463a3f0e439": {"id": "1a817a44-fe12-4146-bea5-8463a3f0e439", "type": "default", "selected": false, "source": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "sourcePort": "660ee671-2c19-4666-bdef-bc41b1d60f49", "target": "40416620-6022-43eb-b868-b900b6b1e314", "targetPort": "2435999b-7377-459a-a1ff-ec806db73863", "points": [{"id": "fc372917-983e-4322-ba0e-579d97058a78", "type": "point", "x": 880.0521245002747, "y": 315.7031407356262}, {"id": "ac8ed169-3c27-4b65-8272-661d8e3bb7e0", "type": "point", "x": 862.0486454963684, "y": 319.70488023757935}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "42f1e419-66f8-40da-9eb0-5d84cda8fcda": {"id": "42f1e419-66f8-40da-9eb0-5d84cda8fcda", "type": "default", "selected": true, "source": "40416620-6022-43eb-b868-b900b6b1e314", "sourcePort": "2ec5d4d7-af07-47f8-9a61-9b62898bd3d8", "target": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "targetPort": "b06901bd-898b-4283-859a-a9d189bb666b", "points": [{"id": "97dfb32b-b3c3-4ed3-9f68-924838f27310", "type": "point", "x": 1264.1319584846497, "y": 267.76042222976685}, {"id": "da89a0fd-541e-43fd-bc57-01b2996fe15a", "type": "point", "x": 1290.6076664924622, "y": 264.3194737434387}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "7479dd66-0c85-4121-ac02-b9f8698ce209": {"id": "7479dd66-0c85-4121-ac02-b9f8698ce209", "type": "default", "selected": true, "source": "40416620-6022-43eb-b868-b900b6b1e314", "sourcePort": "670b1fa8-4bd2-4eff-9276-b243617473c6", "target": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "targetPort": "109dd531-3623-4027-9508-36b9409928bb", "points": [{"id": "eac16ea4-54bd-4d47-b0eb-8d494bdbf5a6", "type": "point", "x": 1264.1319584846497, "y": 383.31599473953247}, {"id": "c2b518ea-71c1-4d4c-89c5-2362de77f0a7", "type": "point", "x": 1290.6076664924622, "y": 379.8750157356262}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "0bb1360c-8105-4ac0-8410-239c6f2eccb0", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"6091aa26-60f8-4e7f-83c6-5966629f63b0": {"id": "6091aa26-60f8-4e7f-83c6-5966629f63b0", "type": "basic.code", "x": 100, "y": 100, "ports": [{"id": "ff1372fc-8658-419d-854e-036acb41e37c", "type": "port.output", "x": 455.5555725097656, "y": 310.20835876464844, "name": "front_distance", "alignment": "right", "parentNode": "6091aa26-60f8-4e7f-83c6-5966629f63b0", "links": ["3bb3c223-3542-4dee-9466-f0b5a178a754"], "in": false, "label": "front_distance", "hideLabel": false}], "data": {"code": "import math\nimport rclpy\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserDistanceBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_distance_block\")\n\n            self.have_scan = False\n            self.ranges = []\n            self.angle_min = 0.0\n            self.angle_increment = 0.0\n            self.front = 10.0\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            self.have_scan = True\n            self.ranges = list(msg.ranges)\n            self.angle_min = msg.angle_min\n            self.angle_increment = msg.angle_increment\n\n        def update_front_distance(self):\n            if not self.have_scan:\n                self.front = 10.0\n                return\n\n            values = []\n\n            for i, dist in enumerate(self.ranges):\n                angle = self.angle_min + i * self.angle_increment\n\n                if -0.35 <= angle <= 0.35:\n                    if math.isfinite(dist) and dist > 0.05:\n                        values.append(dist)\n\n            if values:\n                self.front = min(values)\n            else:\n                self.front = 10.0\n\n    node = LaserDistanceBlock()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n        node.update_front_distance()\n\n        outputs.share_number(\"front_distance\", node.front)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "front_distance"}]}, "size": {"width": "404px", "height": "318px"}}}, "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8": {"id": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "type": "basic.code", "selected": false, "x": 467, "y": 98, "ports": [{"id": "6c00d13e-20e2-4b9e-ae78-b2ffa8edc918", "type": "port.input", "x": 467.5520935058594, "y": 308.20314025878906, "name": "front_distance", "alignment": "left", "parentNode": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "links": ["3bb3c223-3542-4dee-9466-f0b5a178a754"], "in": true, "label": "front_distance", "hideLabel": false}, {"id": "660ee671-2c19-4666-bdef-bc41b1d60f49", "type": "port.output", "x": 872.5521240234375, "y": 308.20314025878906, "name": "state_code", "alignment": "right", "parentNode": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "links": ["1a817a44-fe12-4146-bea5-8463a3f0e439"], "in": false, "label": "state_code", "hideLabel": false}], "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n\n    state = FORWARD\n\n    front_stop_distance = 0.60\n    front_clear_distance = 0.90\n\n    while True:\n        front_wire = inputs.read_number(\"front_distance\")\n\n        if front_wire is None:\n            front = 10.0\n        else:\n            front = float(front_wire[0])\n\n        if state == FORWARD:\n            if front < front_stop_distance:\n                state = TURN_LEFT\n\n        elif state == TURN_LEFT:\n            if front > front_clear_distance:\n                state = FORWARD\n\n        outputs.share_number(\"state_code\", state)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}], "out": [{"name": "state_code"}]}, "size": {"width": "404px", "height": "318px"}}}, "40416620-6022-43eb-b868-b900b6b1e314": {"id": "40416620-6022-43eb-b868-b900b6b1e314", "type": "basic.code", "selected": false, "x": 854, "y": 102, "ports": [{"id": "2435999b-7377-459a-a1ff-ec806db73863", "type": "port.input", "x": 854.5486450195312, "y": 312.2048797607422, "name": "state_code", "alignment": "left", "parentNode": "40416620-6022-43eb-b868-b900b6b1e314", "links": ["1a817a44-fe12-4146-bea5-8463a3f0e439"], "in": true, "label": "state_code", "hideLabel": false}, {"id": "2ec5d4d7-af07-47f8-9a61-9b62898bd3d8", "type": "port.output", "x": 1256.6319580078125, "y": 260.2604217529297, "name": "linear_x", "alignment": "right", "parentNode": "40416620-6022-43eb-b868-b900b6b1e314", "links": ["42f1e419-66f8-40da-9eb0-5d84cda8fcda"], "in": false, "label": "linear_x", "hideLabel": false}, {"id": "670b1fa8-4bd2-4eff-9276-b243617473c6", "type": "port.output", "x": 1256.6319580078125, "y": 375.8159942626953, "name": "angular_z", "alignment": "right", "parentNode": "40416620-6022-43eb-b868-b900b6b1e314", "links": ["7479dd66-0c85-4121-ac02-b9f8698ce209"], "in": false, "label": "angular_z", "hideLabel": false}], "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n\n    forward_speed = 0.70\n    turn_speed = 1.25\n\n    while True:\n        state_wire = inputs.read_number(\"state_code\")\n\n        if state_wire is None:\n            state = FORWARD\n        else:\n            state = float(state_wire[0])\n\n        if state == FORWARD:\n            linear_x = forward_speed\n            angular_z = 0.0\n        elif state == TURN_LEFT:\n            linear_x = 0.0\n            angular_z = turn_speed\n        else:\n            linear_x = 0.0\n            angular_z = 0.0\n\n        outputs.share_number(\"linear_x\", linear_x)\n        outputs.share_number(\"angular_z\", angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "state_code"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}]}, "size": {"width": "300px", "height": "318px"}}}, "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5": {"id": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "type": "basic.code", "selected": true, "x": 1282, "y": 98, "ports": [{"id": "b06901bd-898b-4283-859a-a9d189bb666b", "type": "port.input", "x": 1283.107666015625, "y": 256.81947326660156, "name": "linear_x", "alignment": "left", "parentNode": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "links": ["42f1e419-66f8-40da-9eb0-5d84cda8fcda"], "in": true, "label": "linear_x", "hideLabel": false}, {"id": "109dd531-3623-4027-9508-36b9409928bb", "type": "port.input", "x": 1283.107666015625, "y": 372.37501525878906, "name": "angular_z", "alignment": "left", "parentNode": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "links": ["7479dd66-0c85-4121-ac02-b9f8698ce209"], "in": true, "label": "angular_z", "hideLabel": false}], "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class CmdVelBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_cmd_vel_publisher\")\n            self.pub = self.create_publisher(Twist, \"/turtlebot3/cmd_vel\", 10)\n\n        def publish_cmd(self, linear_x, angular_z):\n            msg = Twist()\n            msg.linear.x = float(linear_x)\n            msg.angular.z = float(angular_z)\n            self.pub.publish(msg)\n\n    node = CmdVelBlock()\n\n    while True:\n        linear_wire = inputs.read_number(\"linear_x\")\n        angular_wire = inputs.read_number(\"angular_z\")\n\n        if linear_wire is None:\n            linear_x = 0.0\n        else:\n            linear_x = float(linear_wire[0])\n\n        if angular_wire is None:\n            angular_z = 0.0\n        else:\n            angular_z = float(angular_wire[0])\n\n        node.publish_cmd(linear_x, angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}], "out": []}, "size": {"width": "404px", "height": "318px"}}}}}]}, "version": "3.0", "package": {"name": "", "version": "", "description": "", "author": "", "image": ""}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "6091aa26-60f8-4e7f-83c6-5966629f63b0", "type": "basic.code", "data": {"code": "import math\nimport rclpy\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserDistanceBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_distance_block\")\n\n            self.have_scan = False\n            self.ranges = []\n            self.angle_min = 0.0\n            self.angle_increment = 0.0\n            self.front = 10.0\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            self.have_scan = True\n            self.ranges = list(msg.ranges)\n            self.angle_min = msg.angle_min\n            self.angle_increment = msg.angle_increment\n\n        def update_front_distance(self):\n            if not self.have_scan:\n                self.front = 10.0\n                return\n\n            values = []\n\n            for i, dist in enumerate(self.ranges):\n                angle = self.angle_min + i * self.angle_increment\n\n                if -0.35 <= angle <= 0.35:\n                    if math.isfinite(dist) and dist > 0.05:\n                        values.append(dist)\n\n            if values:\n                self.front = min(values)\n            else:\n                self.front = 10.0\n\n    node = LaserDistanceBlock()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n        node.update_front_distance()\n\n        outputs.share_number(\"front_distance\", node.front)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "front_distance"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 100, "y": 100}}, {"id": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "type": "basic.code", "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n\n    state = FORWARD\n\n    front_stop_distance = 0.60\n    front_clear_distance = 0.90\n\n    while True:\n        front_wire = inputs.read_number(\"front_distance\")\n\n        if front_wire is None:\n            front = 10.0\n        else:\n            front = float(front_wire[0])\n\n        if state == FORWARD:\n            if front < front_stop_distance:\n                state = TURN_LEFT\n\n        elif state == TURN_LEFT:\n            if front > front_clear_distance:\n                state = FORWARD\n\n        outputs.share_number(\"state_code\", state)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}], "out": [{"name": "state_code"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 467, "y": 98}}, {"id": "40416620-6022-43eb-b868-b900b6b1e314", "type": "basic.code", "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n\n    forward_speed = 0.70\n    turn_speed = 1.25\n\n    while True:\n        state_wire = inputs.read_number(\"state_code\")\n\n        if state_wire is None:\n            state = FORWARD\n        else:\n            state = float(state_wire[0])\n\n        if state == FORWARD:\n            linear_x = forward_speed\n            angular_z = 0.0\n        elif state == TURN_LEFT:\n            linear_x = 0.0\n            angular_z = turn_speed\n        else:\n            linear_x = 0.0\n            angular_z = 0.0\n\n        outputs.share_number(\"linear_x\", linear_x)\n        outputs.share_number(\"angular_z\", angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "state_code"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}]}, "size": {"width": "300px", "height": "318px"}}, "position": {"x": 854, "y": 102}}, {"id": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "type": "basic.code", "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class CmdVelBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_cmd_vel_publisher\")\n            self.pub = self.create_publisher(Twist, \"/turtlebot3/cmd_vel\", 10)\n\n        def publish_cmd(self, linear_x, angular_z):\n            msg = Twist()\n            msg.linear.x = float(linear_x)\n            msg.angular.z = float(angular_z)\n            self.pub.publish(msg)\n\n    node = CmdVelBlock()\n\n    while True:\n        linear_wire = inputs.read_number(\"linear_x\")\n        angular_wire = inputs.read_number(\"angular_z\")\n\n        if linear_wire is None:\n            linear_x = 0.0\n        else:\n            linear_x = float(linear_wire[0])\n\n        if angular_wire is None:\n            angular_z = 0.0\n        else:\n            angular_z = float(angular_wire[0])\n\n        node.publish_cmd(linear_x, angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}], "out": []}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 1282, "y": 98}}], "wires": [{"source": {"block": "6091aa26-60f8-4e7f-83c6-5966629f63b0", "port": "front_distance", "name": "front_distance"}, "target": {"block": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "port": "front_distance", "name": "front_distance"}}, {"source": {"block": "d3306a26-06f6-4ef7-b245-f0e84b1b6ab8", "port": "state_code", "name": "state_code"}, "target": {"block": "40416620-6022-43eb-b868-b900b6b1e314", "port": "state_code", "name": "state_code"}}, {"source": {"block": "40416620-6022-43eb-b868-b900b6b1e314", "port": "linear_x", "name": "linear_x"}, "target": {"block": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "port": "linear_x", "name": "linear_x"}}, {"source": {"block": "40416620-6022-43eb-b868-b900b6b1e314", "port": "angular_z", "name": "angular_z"}, "target": {"block": "e4eb7c74-fc4f-47b6-bec3-67e7302f14d5", "port": "angular_z", "name": "angular_z"}}]}}, "dependencies": {}}