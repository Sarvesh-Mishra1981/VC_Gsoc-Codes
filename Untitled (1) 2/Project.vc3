{"editor": {"id": "5ee48f1f-00a9-4069-bedc-204a33e8526e", "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "f4bc3d37-bbc2-4938-b828-905babde107a", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {}}, {"id": "d86552f7-6335-4352-ae05-777911db6509", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"32b64322-7d9b-4a2a-bc1e-55dd1cfeae1c": {"id": "32b64322-7d9b-4a2a-bc1e-55dd1cfeae1c", "type": "basic.code", "x": 100, "y": 100, "ports": [{"id": "fcea8831-cc4b-43df-947f-e2d1470e47f7", "type": "port.output", "x": 421.28472900390625, "y": 316.0416717529297, "name": "out", "alignment": "right", "parentNode": "32b64322-7d9b-4a2a-bc1e-55dd1cfeae1c", "links": [], "in": false, "label": "out", "hideLabel": false}], "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class ForceForward(Node):\n        def __init__(self):\n            super().__init__(\"vc_force_forward_test\")\n            self.pub = self.create_publisher(Twist, \"/turtlebot3/cmd_vel\", 10)\n\n        def publish_cmd(self):\n            msg = Twist()\n            msg.linear.x = 0.20\n            msg.angular.z = 0.0\n            self.pub.publish(msg)\n\n    node = ForceForward()\n\n    while True:\n        node.publish_cmd()\n        rclpy.spin_once(node, timeout_sec=0.0)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "out"}]}, "size": {"width": "404px", "height": "318px"}}}}}]}, "version": "3.0", "package": {"name": "", "version": "", "description": "", "author": "", "image": ""}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "32b64322-7d9b-4a2a-bc1e-55dd1cfeae1c", "type": "basic.code", "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class ForceForward(Node):\n        def __init__(self):\n            super().__init__(\"vc_force_forward_test\")\n            self.pub = self.create_publisher(Twist, \"/turtlebot3/cmd_vel\", 10)\n\n        def publish_cmd(self):\n            msg = Twist()\n            msg.linear.x = 0.20\n            msg.angular.z = 0.0\n            self.pub.publish(msg)\n\n    node = ForceForward()\n\n    while True:\n        node.publish_cmd()\n        rclpy.spin_once(node, timeout_sec=0.0)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "out"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 100, "y": 100}}], "wires": []}}, "dependencies": {}}