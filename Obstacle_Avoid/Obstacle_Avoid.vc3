d5f-802f-47a607fb3801", "type": "point", "x": 1436.9879155158997, "y": 547.1962132453918}, {"id": "c8d318be-f218-4908-b74f-879d9da81883", "type": "point", "x": 1577.0487065315247, "y": 504.9913182258606}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "fcac3d46-b46f-4b24-9e41-e729de31940e", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"7e9f6aab-d23f-4c6e-af49-4fb91bbe9812": {"id": "7e9f6aab-d23f-4c6e-af49-4fb91bbe9812", "type": "basic.input", "selected": false, "x": 369, "y": 414, "ports": [{"id": "71d8c685-aacb-4f69-a283-c58fde872d90", "type": "port.output", "x": 454.54864501953125, "y": 432.49134826660156, "name": "input-out", "alignment": "right", "parentNode": "7e9f6aab-d23f-4c6e-af49-4fb91bbe9812", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "742b497b-3926-4f88-947f-d06fd6005f60": {"id": "742b497b-3926-4f88-947f-d06fd6005f60", "type": "basic.constant", "selected": true, "x": 629, "y": 6, "ports": [{"id": "b13c8c01-6787-41ce-a99b-510273e0574b", "type": "port.output", "x": 682.6041870117188, "y": 113.9757080078125, "name": "constant-out", "alignment": "bottom", "parentNode": "742b497b-3926-4f88-947f-d06fd6005f60", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": false, "label": "ROSTopic", "hideLabel": true}], "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}}, "4dc117ec-eeb8-4bfc-bc83-048be68af223": {"id": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "type": "basic.code", "selected": false, "x": 520, "y": 173, "ports": [{"id": "3b9ed83f-8c6a-40b8-a35b-66802a3b5d6a", "type": "port.input", "x": 520.5556030273438, "y": 539.6962127685547, "name": "Enable", "alignment": "left", "parentNode": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "links": ["fc46db03-af4c-4ee8-af3c-794247143848"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "2fcfd378-b701-4741-923c-388e9e5e8fbd", "type": "port.output", "x": 1429.4879150390625, "y": 539.6962127685547, "name": "Out", "alignment": "right", "parentNode": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": false, "label": "Out", "hideLabel": false}, {"id": "d37fce43-929b-4e83-831c-7e98b9884cee", "type": "port.parameter", "x": 975.0173950195312, "y": 242.3697967529297, "name": "ROSTopic", "alignment": "top", "parentNode": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "links": ["dc56ba0a-7e88-486e-a516-60b4d2d2e47b"], "in": true, "label": "ROSTopic", "hideLabel": false}], "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}}, "552f4a56-83c4-4236-8250-59869f9a5eea": {"id": "552f4a56-83c4-4236-8250-59869f9a5eea", "type": "basic.output", "selected": false, "x": 1569, "y": 479, "ports": [{"id": "365e60aa-68cf-46e1-ba34-84e48468aef9", "type": "port.input", "x": 1569.5487060546875, "y": 497.49131774902344, "name": "output-in", "alignment": "left", "parentNode": "552f4a56-83c4-4236-8250-59869f9a5eea", "links": ["4f38fd9d-8c95-4107-9711-cfd465e91876"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}}}]}, "info": {"name": "ROS2LaserScan", "version": "1.0.0", "description": "Reads laser data and shares an array with its measures", "author": "David Tapiador de Vera", "image": "data:image/png;base64,"}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "7e9f6aab-d23f-4c6e-af49-4fb91bbe9812", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": 369, "y": 414}}, {"id": "742b497b-3926-4f88-947f-d06fd6005f60", "type": "basic.constant", "data": {"name": "ROSTopic", "value": "/f1/laser/scan", "local": true}, "position": {"x": 629, "y": 6}}, {"id": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "type": "basic.code", "data": {"code": "#!/usr/bin/env python3\n\nimport numpy as np\nimport rclpy\nfrom rclpy.node import Node\nfrom cv_bridge import CvBridge\nfrom sensor_msgs.msg import LaserScan\n\nbridge = CvBridge()\nmeasure = None\n\n# ros2 node class\nclass LaserSubscriber(Node):\n\n    def __init__(self, topic):\n\n        super().__init__('laser_subscriber')\n\n        self.subscription = self.create_subscription(\n            LaserScan, topic, self.callback, 10)\n\n        self.subscription  # prevent unused variable warning\n\n\n    def callback(self, msg):\n\n        global measure\n\n        measure = []\n        for i in range(len(msg.ranges)):\n            measure.extend((str(msg.ranges[i]),))\n\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    \n    global measure\n\n    auto_enable = False\n    try:\n        enable = inputs.read_number('Enable')\n    except Exception:\n        auto_enable = True\n\n    rclpy.init()\n    laser_subscriber = LaserSubscriber(parameters.read_string(\"ROSTopic\"))\n\n    try:\n        while auto_enable or inputs.read_number('Enable'):\n            measure = None\n            rclpy.spin_once(laser_subscriber)\n\n            if measure is not None:\n                outputs.share_array(\"Out\",measure)   \n\n            synchronise()  \n    except Exception as e:\n        print('Error:', e)\n        pass\n    finally:\n        print(\"Exiting\")\n        synchronise()     \n        laser_subscriber.destroy_node()\n        rclpy.shutdown()\n", "frequency": "30", "params": [{"name": "ROSTopic"}], "ports": {"in": [{"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "854px", "height": "548px"}}, "position": {"x": 520, "y": 173}}, {"id": "552f4a56-83c4-4236-8250-59869f9a5eea", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 1569, "y": 479}}], "wires": [{"source": {"block": "7e9f6aab-d23f-4c6e-af49-4fb91bbe9812", "port": "input-out", "name": "Enable"}, "target": {"block": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "port": "Enable", "name": "Enable"}}, {"source": {"block": "742b497b-3926-4f88-947f-d06fd6005f60", "port": "constant-out", "name": "ROSTopic"}, "target": {"block": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "port": "ROSTopic", "name": "ROSTopic"}}, {"source": {"block": "4dc117ec-eeb8-4bfc-bc83-048be68af223", "port": "Out", "name": "Out"}, "target": {"block": "552f4a56-83c4-4236-8250-59869f9a5eea", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}, "ce998d20-6217-43af-84cc-18561172229e": {"id": "ce998d20-6217-43af-84cc-18561172229e", "type": "block.package", "select