{"editor": {"id": "7b288fe8-91a9-4b6d-a34e-79ac4a2e1a45", "offsetX": 0, "offsetY": 0, "zoom": 100, "gridSize": 0, "layers": [{"id": "8d5de29a-700e-4ae3-95e0-97699cb4708c", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"b88c4794-6201-4456-99c8-c80cd2f97be6": {"id": "b88c4794-6201-4456-99c8-c80cd2f97be6", "type": "default", "selected": false, "source": "297543fe-9766-4858-95f0-4eca8f39af48", "sourcePort": "f602b80d-dbc7-4f24-982b-69f296321358", "target": null, "targetPort": null, "points": [{"id": "0859c132-bda1-44cc-8312-8f0fd9cf776f", "type": "point", "x": 516.0416874885559, "y": 260.98091173171997}, {"id": "35a28dc7-ff16-4e4f-ad33-eecac289f8c1", "type": "point", "x": 461, "y": 254.00694274902344}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "58531480-08db-4042-88d9-55ae4ab6caca": {"id": "58531480-08db-4042-88d9-55ae4ab6caca", "type": "default", "selected": false, "source": "297543fe-9766-4858-95f0-4eca8f39af48", "sourcePort": "41b67197-1c27-4812-8e2e-ee2c3c5a3574", "target": null, "targetPort": null, "points": [{"id": "eededc8b-609a-49ef-b1ee-ebf1d34bf572", "type": "point", "x": 516.0416874885559, "y": 386.42363023757935}, {"id": "7fc56b4f-3448-4f12-8664-01033b6020ea", "type": "point", "selected": false, "x": 462, "y": 379.00694274902344}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "5e66f036-330c-4396-9727-ad2384bd8e5e": {"id": "5e66f036-330c-4396-9727-ad2384bd8e5e", "type": "default", "selected": false, "source": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "sourcePort": "59fab7f9-bc2a-4e1d-9a85-6adff04af800", "target": "73f90f28-97e4-40dd-be28-673ea9142224", "targetPort": "2fcc2a31-6bac-44c2-8aab-b397a01bc641", "points": [{"id": "1ff5704f-5fdd-484f-bdc9-5e4d4a37961d", "type": "point", "x": 1021.0416874885559, "y": 309.6961827278137}, {"id": "1fa76bb0-8ac8-48d2-bb6f-a0da86cd398a", "type": "point", "x": 870.0521245002747, "y": 315.6944737434387}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "1081c185-c3a0-4d37-9f73-73cadf2994f2": {"id": "1081c185-c3a0-4d37-9f73-73cadf2994f2", "type": "default", "selected": false, "source": "73f90f28-97e4-40dd-be28-673ea9142224", "sourcePort": "459ce771-2d5d-40bf-9619-23d2bcbc9f85", "target": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "targetPort": "d2c4b7a1-74f6-4424-8b44-f8e3cded7004", "points": [{"id": "7d25951f-fafb-445a-be46-968a5a0627ef", "type": "point", "x": 1376.1285405158997, "y": 260.7552342414856}, {"id": "b9393776-95a9-4eff-bd76-874d26e0404a", "type": "point", "x": 1297.0487065315247, "y": 261.76216173171997}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "d67c83f9-9e25-4381-9701-79322b6cd056": {"id": "d67c83f9-9e25-4381-9701-79322b6cd056", "type": "default", "selected": false, "source": "73f90f28-97e4-40dd-be28-673ea9142224", "sourcePort": "c0eef322-5a0e-448e-a621-19826818cb09", "target": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "targetPort": "b74cc7b1-0d1d-4be8-be60-9672b5bdb466", "points": [{"id": "dcd9959b-2e0a-4451-ad14-9753a46904f0", "type": "point", "x": 1376.1285405158997, "y": 382.30903673171997}, {"id": "891b7818-c0fc-41cc-af20-b61037c75ad7", "type": "point", "x": 1297.0487065315247, "y": 383.31599473953247}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "0e4cb873-002b-485e-9720-1c81b106b2bd": {"id": "0e4cb873-002b-485e-9720-1c81b106b2bd", "type": "default", "selected": false, "source": "297543fe-9766-4858-95f0-4eca8f39af48", "sourcePort": "f602b80d-dbc7-4f24-982b-69f296321358", "target": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "targetPort": "b579443d-aeab-4fea-8850-e970dd89b81b", "points": [{"id": "9a011753-bf3f-407f-893e-a3006de9520e", "type": "point", "x": 516.0416874885559, "y": 260.98091173171997}, {"id": "42ca8951-37c7-45b1-8008-00343263c6ec", "type": "point", "x": 512.0486454963684, "y": 246.97917222976685}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "d5c9a664-0be5-4f01-a464-e2a02468c3a2": {"id": "d5c9a664-0be5-4f01-a464-e2a02468c3a2", "type": "default", "selected": false, "source": "297543fe-9766-4858-95f0-4eca8f39af48", "sourcePort": "41b67197-1c27-4812-8e2e-ee2c3c5a3574", "target": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "targetPort": "da0a6441-16c7-4b65-85c3-b05f49d087a4", "points": [{"id": "e6bfd1c3-e760-4247-8ca5-2a4c8b73e170", "type": "point", "x": 516.0416874885559, "y": 386.42363023757935}, {"id": "c63f1d71-b106-4c4e-a027-5a9c450b9429", "type": "point", "x": 512.0486454963684, "y": 372.4218907356262}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "1eb248c0-eece-49fd-a0f8-295dfcf44815": {"id": "1eb248c0-eece-49fd-a0f8-295dfcf44815", "type": "default", "selected": false, "source": "297543fe-9766-4858-95f0-4eca8f39af48", "sourcePort": "41b67197-1c27-4812-8e2e-ee2c3c5a3574", "target": "e1c6341e-c2f4-4522-a7ad-4b00fc2fedd8", "targetPort": "20a4e8c6-3823-4bb8-a490-86db427dfde1", "points": [{"id": "c5467c84-3026-4071-bf1e-77d1ba96254a", "type": "point", "x": 516.0416874885559, "y": 386.42363023757935}, {"id": "9955a096-8596-4c90-8abe-aa7d9964d8e2", "type": "point", "selected": false, "x": 447, "y": 465.00694274902344}, {"id": "55694da4-829a-4fe2-ad24-e1dccc0fefc1", "type": "point", "x": 528.6111454963684, "y": 558.2535252571106}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "ca077908-3ddc-431d-977b-ee458d424ea5", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"297543fe-9766-4858-95f0-4eca8f39af48": {"id": "297543fe-9766-4858-95f0-4eca8f39af48", "type": "basic.code", "selected": false, "x": 49, "y": 97, "ports": [{"id": "f602b80d-dbc7-4f24-982b-69f296321358", "type": "port.output", "x": 508.54168701171875, "y": 253.4809112548828, "name": "front_distance", "alignment": "right", "parentNode": "297543fe-9766-4858-95f0-4eca8f39af48", "links": ["b88c4794-6201-4456-99c8-c80cd2f97be6", "0e4cb873-002b-485e-9720-1c81b106b2bd"], "in": false, "label": "front_distance", "hideLabel": false}, {"id": "41b67197-1c27-4812-8e2e-ee2c3c5a3574", "type": "port.output", "x": 508.54168701171875, "y": 378.9236297607422, "name": "laser_ready", "alignment": "right", "parentNode": "297543fe-9766-4858-95f0-4eca8f39af48", "links": ["58531480-08db-4042-88d9-55ae4ab6caca", "d5c9a664-0be5-4f01-a464-e2a02468c3a2", "1eb248c0-eece-49fd-a0f8-295dfcf44815"], "in": false, "label": "laser_ready", "hideLabel": false}], "data": {"code": "import math\nimport rclpy\n\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserReader(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_reader\")\n\n            self.front_distance = 10.0\n            self.laser_ready = False\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            values = []\n\n            for index, distance in enumerate(msg.ranges):\n                angle = msg.angle_min + index * msg.angle_increment\n\n                if -0.35 <= angle <= 0.35:\n                    if math.isfinite(distance) and distance > 0.05:\n                        values.append(distance)\n\n            self.front_distance = min(values) if values else 10.0\n            self.laser_ready = True\n\n    node = LaserReader()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n\n        outputs.share_number(\n            \"front_distance\",\n            node.front_distance,\n        )\n        outputs.share_number(\n            \"laser_ready\",\n            1.0 if node.laser_ready else 0.0,\n        )\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "front_distance"}, {"name": "laser_ready"}]}, "size": {"width": "404px", "height": "318px"}}}, "906f0857-8cc2-4b73-8589-9ccfe98c70f7": {"id": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "type": "basic.code", "selected": false, "x": 504, "y": 83, "ports": [{"id": "b579443d-aeab-4fea-8850-e970dd89b81b", "type": "port.input", "x": 504.54864501953125, "y": 239.4791717529297, "name": "front_distance", "alignment": "left", "parentNode": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "links": ["0e4cb873-002b-485e-9720-1c81b106b2bd"], "in": true, "label": "front_distance", "hideLabel": false}, {"id": "da0a6441-16c7-4b65-85c3-b05f49d087a4", "type": "port.input", "x": 504.54864501953125, "y": 364.92189025878906, "name": "laser_ready", "alignment": "left", "parentNode": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "links": ["d5c9a664-0be5-4f01-a464-e2a02468c3a2"], "in": true, "label": "laser_ready", "hideLabel": false}, {"id": "59fab7f9-bc2a-4e1d-9a85-6adff04af800", "type": "port.output", "x": 1013.5416870117188, "y": 302.19618225097656, "name": "state_code", "alignment": "right", "parentNode": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "links": ["5e66f036-330c-4396-9727-ad2384bd8e5e"], "in": false, "label": "state_code", "hideLabel": false}], "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n    STOP = 2.0\n\n    state = STOP\n\n    stop_distance = 0.60\n    clear_distance = 0.90\n\n    while True:\n        distance_wire = inputs.read_number(\"front_distance\")\n        ready_wire = inputs.read_number(\"laser_ready\")\n\n        laser_ready = (\n            ready_wire is not None\n            and float(ready_wire[0]) > 0.5\n        )\n\n        if not laser_ready or distance_wire is None:\n            state = STOP\n        else:\n            front_distance = float(distance_wire[0])\n\n            if state == STOP:\n                state = FORWARD\n\n            if state == FORWARD:\n                if front_distance < stop_distance:\n                    state = TURN_LEFT\n\n            elif state == TURN_LEFT:\n                if front_distance > clear_distance:\n                    state = FORWARD\n\n        outputs.share_number(\"state_code\", state)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}, {"name": "laser_ready"}], "out": [{"name": "state_code"}]}, "size": {"width": "414px", "height": "328px"}}}, "73f90f28-97e4-40dd-be28-673ea9142224": {"id": "73f90f28-97e4-40dd-be28-673ea9142224", "type": "basic.code", "selected": false, "x": 862, "y": 89, "ports": [{"id": "2fcc2a31-6bac-44c2-8aab-b397a01bc641", "type": "port.input", "x": 862.5521240234375, "y": 308.19447326660156, "name": "state_code", "alignment": "left", "parentNode": "73f90f28-97e4-40dd-be28-673ea9142224", "links": ["5e66f036-330c-4396-9727-ad2384bd8e5e"], "in": true, "label": "state_code", "hideLabel": false}, {"id": "459ce771-2d5d-40bf-9619-23d2bcbc9f85", "type": "port.output", "x": 1368.6285400390625, "y": 253.25523376464844, "name": "linear_x", "alignment": "right", "parentNode": "73f90f28-97e4-40dd-be28-673ea9142224", "links": ["1081c185-c3a0-4d37-9f73-73cadf2994f2"], "in": false, "label": "linear_x", "hideLabel": false}, {"id": "c0eef322-5a0e-448e-a621-19826818cb09", "type": "port.output", "x": 1368.6285400390625, "y": 374.8090362548828, "name": "angular_z", "alignment": "right", "parentNode": "73f90f28-97e4-40dd-be28-673ea9142224", "links": ["d67c83f9-9e25-4381-9701-79322b6cd056"], "in": false, "label": "angular_z", "hideLabel": false}], "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n\n    forward_speed = 0.70\n    turn_speed = 1.25\n\n    while True:\n        state_wire = inputs.read_number(\"state_code\")\n\n        linear_x = 0.0\n        angular_z = 0.0\n\n        if state_wire is not None:\n            state = float(state_wire[0])\n\n            if state == FORWARD:\n                linear_x = forward_speed\n\n            elif state == TURN_LEFT:\n                angular_z = turn_speed\n\n        outputs.share_number(\"linear_x\", linear_x)\n        outputs.share_number(\"angular_z\", angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "state_code"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}]}, "size": {"width": "404px", "height": "318px"}}}, "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9": {"id": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "type": "basic.code", "selected": false, "x": 1289, "y": 90, "ports": [{"id": "d2c4b7a1-74f6-4424-8b44-f8e3cded7004", "type": "port.input", "x": 1289.5487060546875, "y": 254.2621612548828, "name": "linear_x", "alignment": "left", "parentNode": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "links": ["1081c185-c3a0-4d37-9f73-73cadf2994f2"], "in": true, "label": "linear_x", "hideLabel": false}, {"id": "b74cc7b1-0d1d-4be8-be60-9672b5bdb466", "type": "port.input", "x": 1289.5487060546875, "y": 375.8159942626953, "name": "angular_z", "alignment": "left", "parentNode": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "links": ["d67c83f9-9e25-4381-9701-79322b6cd056"], "in": true, "label": "angular_z", "hideLabel": false}], "data": {"code": "import rclpy\n\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class VelocityPublisher(Node):\n        def __init__(self):\n            super().__init__(\"vc_velocity_publisher\")\n\n            self.publisher = self.create_publisher(\n                Twist,\n                \"/turtlebot3/cmd_vel\",\n                10,\n            )\n\n        def send_velocity(self, linear_x, angular_z):\n            command = Twist()\n            command.linear.x = float(linear_x)\n            command.angular.z = float(angular_z)\n            self.publisher.publish(command)\n\n    node = VelocityPublisher()\n\n    while True:\n        linear_wire = inputs.read_number(\"linear_x\")\n        angular_wire = inputs.read_number(\"angular_z\")\n\n        linear_x = (\n            float(linear_wire[0])\n            if linear_wire is not None\n            else 0.0\n        )\n        angular_z = (\n            float(angular_wire[0])\n            if angular_wire is not None\n            else 0.0\n        )\n\n        node.send_velocity(linear_x, angular_z)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}], "out": []}, "size": {"width": "404px", "height": "318px"}}}, "e1c6341e-c2f4-4522-a7ad-4b00fc2fedd8": {"id": "e1c6341e-c2f4-4522-a7ad-4b00fc2fedd8", "type": "basic.code", "selected": true, "x": 520, "y": 331, "ports": [{"id": "20a4e8c6-3823-4bb8-a490-86db427dfde1", "type": "port.input", "x": 521.1111450195312, "y": 550.7535247802734, "name": "laser_ready", "alignment": "left", "parentNode": "e1c6341e-c2f4-4522-a7ad-4b00fc2fedd8", "links": ["1eb248c0-eece-49fd-a0f8-295dfcf44815"], "in": true, "label": "laser_ready", "hideLabel": false}], "data": {"code": "import math\nimport numpy as np\nimport rclpy\nimport threading\n\nfrom rclpy.node import Node\nfrom rclpy.qos import (\n    QoSProfile,\n    DurabilityPolicy,\n    qos_profile_sensor_data,\n)\nfrom nav_msgs.msg import Odometry\nfrom sensor_msgs.msg import LaserScan, Image\n\n\nWIDTH = 1500\nHEIGHT = 970\n\n\ndef quaternion_to_yaw(q):\n    numerator = 2.0 * (q.w * q.z + q.x * q.y)\n    denominator = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n    return math.atan2(numerator, denominator)\n\n\ndef pose_to_map(world_x, world_y):\n    pixel_y = -23.58 * (-20.36 - world_x)\n    pixel_x = -23.53 * (-31.95 - world_y)\n\n    return round(pixel_x), round(pixel_y)\n\n\ndef bresenham(x0, y0, x1, y1):\n    points = []\n\n    dx = abs(x1 - x0)\n    dy = abs(y1 - y0)\n\n    step_x = 1 if x0 < x1 else -1\n    step_y = 1 if y0 < y1 else -1\n\n    error = dx - dy\n\n    while True:\n        points.append((x0, y0))\n\n        if x0 == x1 and y0 == y1:\n            break\n\n        double_error = 2 * error\n\n        if double_error > -dy:\n            error -= dy\n            x0 += step_x\n\n        if double_error < dx:\n            error += dx\n            y0 += step_y\n\n    return points\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class MapPublisher(Node):\n        def __init__(self):\n            super().__init__(\"vc_ra_map_publisher\")\n\n            self.world_x = 0.0\n            self.world_y = 0.0\n            self.yaw = 0.0\n\n            self.have_odom = False\n            self.scan = None\n\n            self.last_x = None\n            self.last_y = None\n            self.last_yaw = None\n\n            self.log_map = np.zeros(\n                (HEIGHT, WIDTH),\n                dtype=np.float32,\n            )\n            self.image_map = np.full(\n                (HEIGHT, WIDTH),\n                128,\n                dtype=np.uint8,\n            )\n\n            map_qos = QoSProfile(\n                depth=1,\n                durability=DurabilityPolicy.TRANSIENT_LOCAL,\n            )\n\n            self.map_publisher = self.create_publisher(\n                Image,\n                \"/webgui/user_map\",\n                map_qos,\n            )\n\n            self.create_subscription(\n                Odometry,\n                \"/turtlebot3/odom\",\n                self.odom_callback,\n                qos_profile_sensor_data,\n            )\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def odom_callback(self, msg):\n            self.world_x = msg.pose.pose.position.x\n            self.world_y = msg.pose.pose.position.y\n            self.yaw = quaternion_to_yaw(\n                msg.pose.pose.orientation\n            )\n            self.have_odom = True\n\n        def scan_callback(self, msg):\n            self.scan = msg\n            # Check the input wire status inside callback\n            ready_wire = inputs.read_number(\"laser_ready\")\n            if ready_wire is None or float(ready_wire[0]) > 0.5:\n                self.update_map()\n\n        def robot_moved(self):\n            if self.last_x is None:\n                return True\n\n            distance = math.hypot(\n                self.world_x - self.last_x,\n                self.world_y - self.last_y,\n            )\n\n            angle_difference = abs(\n                self.yaw - self.last_yaw\n            )\n            angle_difference = min(\n                angle_difference,\n                2.0 * math.pi - angle_difference,\n            )\n\n            return (\n                distance > 0.05\n                or angle_difference > 0.05\n            )\n\n        def update_map(self):\n            if not self.have_odom or self.scan is None:\n                return\n\n            if not self.robot_moved():\n                return\n\n            self.last_x = self.world_x\n            self.last_y = self.world_y\n            self.last_yaw = self.yaw\n\n            robot_x, robot_y = pose_to_map(\n                self.world_x,\n                self.world_y,\n            )\n\n            for index in range(\n                0,\n                len(self.scan.ranges),\n                3,\n            ):\n                distance = self.scan.ranges[index]\n\n                if not math.isfinite(distance):\n                    continue\n\n                if distance < 0.10 or distance > 10.0:\n                    continue\n\n                laser_angle = (\n                    self.scan.angle_min\n                    + index * self.scan.angle_increment\n                )\n                world_angle = self.yaw + laser_angle\n\n                hit_world_x = (\n                    self.world_x\n                    + distance * math.cos(world_angle)\n                )\n                hit_world_y = (\n                    self.world_y\n                    + distance * math.sin(world_angle)\n                )\n\n                hit_x, hit_y = pose_to_map(\n                    hit_world_x,\n                    hit_world_y,\n                )\n\n                line = bresenham(\n                    robot_x,\n                    robot_y,\n                    hit_x,\n                    hit_y,\n                )\n\n                for cell_x, cell_y in line[:-1]:\n                    if (\n                        0 <= cell_x < WIDTH\n                        and 0 <= cell_y < HEIGHT\n                    ):\n                        self.log_map[\n                            cell_y,\n                            cell_x,\n                        ] -= 0.4\n\n                if (\n                    0 <= hit_x < WIDTH\n                    and 0 <= hit_y < HEIGHT\n                ):\n                    self.log_map[hit_y, hit_x] += 0.9\n\n            np.clip(\n                self.log_map,\n                -5.0,\n                5.0,\n                out=self.log_map,\n            )\n\n            self.image_map.fill(128)\n            self.image_map[self.log_map < -2.0] = 255\n            self.image_map[self.log_map > 2.0] = 0\n\n            self.publish_map()\n\n        def publish_map(self):\n            message = Image()\n\n            message.header.stamp = (\n                self.get_clock().now().to_msg()\n            )\n            message.header.frame_id = \"odom\"\n\n            message.height = HEIGHT\n            message.width = WIDTH\n            message.encoding = \"mono8\"\n            message.is_bigendian = False\n            message.step = WIDTH\n            message.data = self.image_map.tobytes()\n\n            self.map_publisher.publish(message)\n\n    node = MapPublisher()\n\n    # Start spinning the node in a background thread\n    spin_thread = threading.Thread(target=rclpy.spin, args=(node,), daemon=True)\n    spin_thread.start()\n\n    try:\n        while True:\n            synchronise()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        node.destroy_node()", "frequency": "30", "params": [], "ports": {"in": [{"name": "laser_ready"}], "out": []}, "size": {"width": "614px", "height": "300px"}}}}}]}, "version": "3.0", "package": {"name": "Block_laser", "version": "", "description": "", "author": "", "image": "", "category": "", "tags": []}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "297543fe-9766-4858-95f0-4eca8f39af48", "type": "basic.code", "data": {"code": "import math\nimport rclpy\n\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserReader(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_reader\")\n\n            self.front_distance = 10.0\n            self.laser_ready = False\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            values = []\n\n            for index, distance in enumerate(msg.ranges):\n                angle = msg.angle_min + index * msg.angle_increment\n\n                if -0.35 <= angle <= 0.35:\n                    if math.isfinite(distance) and distance > 0.05:\n                        values.append(distance)\n\n            self.front_distance = min(values) if values else 10.0\n            self.laser_ready = True\n\n    node = LaserReader()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n\n        outputs.share_number(\n            \"front_distance\",\n            node.front_distance,\n        )\n        outputs.share_number(\n            \"laser_ready\",\n            1.0 if node.laser_ready else 0.0,\n        )\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "front_distance"}, {"name": "laser_ready"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 49, "y": 97}}, {"id": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "type": "basic.code", "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n    STOP = 2.0\n\n    state = STOP\n\n    stop_distance = 0.60\n    clear_distance = 0.90\n\n    while True:\n        distance_wire = inputs.read_number(\"front_distance\")\n        ready_wire = inputs.read_number(\"laser_ready\")\n\n        laser_ready = (\n            ready_wire is not None\n            and float(ready_wire[0]) > 0.5\n        )\n\n        if not laser_ready or distance_wire is None:\n            state = STOP\n        else:\n            front_distance = float(distance_wire[0])\n\n            if state == STOP:\n                state = FORWARD\n\n            if state == FORWARD:\n                if front_distance < stop_distance:\n                    state = TURN_LEFT\n\n            elif state == TURN_LEFT:\n                if front_distance > clear_distance:\n                    state = FORWARD\n\n        outputs.share_number(\"state_code\", state)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}, {"name": "laser_ready"}], "out": [{"name": "state_code"}]}, "size": {"width": "414px", "height": "328px"}}, "position": {"x": 504, "y": 83}}, {"id": "73f90f28-97e4-40dd-be28-673ea9142224", "type": "basic.code", "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    FORWARD = 0.0\n    TURN_LEFT = 1.0\n\n    forward_speed = 0.70\n    turn_speed = 1.25\n\n    while True:\n        state_wire = inputs.read_number(\"state_code\")\n\n        linear_x = 0.0\n        angular_z = 0.0\n\n        if state_wire is not None:\n            state = float(state_wire[0])\n\n            if state == FORWARD:\n                linear_x = forward_speed\n\n            elif state == TURN_LEFT:\n                angular_z = turn_speed\n\n        outputs.share_number(\"linear_x\", linear_x)\n        outputs.share_number(\"angular_z\", angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "state_code"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 862, "y": 89}}, {"id": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "type": "basic.code", "data": {"code": "import rclpy\n\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class VelocityPublisher(Node):\n        def __init__(self):\n            super().__init__(\"vc_velocity_publisher\")\n\n            self.publisher = self.create_publisher(\n                Twist,\n                \"/turtlebot3/cmd_vel\",\n                10,\n            )\n\n        def send_velocity(self, linear_x, angular_z):\n            command = Twist()\n            command.linear.x = float(linear_x)\n            command.angular.z = float(angular_z)\n            self.publisher.publish(command)\n\n    node = VelocityPublisher()\n\n    while True:\n        linear_wire = inputs.read_number(\"linear_x\")\n        angular_wire = inputs.read_number(\"angular_z\")\n\n        linear_x = (\n            float(linear_wire[0])\n            if linear_wire is not None\n            else 0.0\n        )\n        angular_z = (\n            float(angular_wire[0])\n            if angular_wire is not None\n            else 0.0\n        )\n\n        node.send_velocity(linear_x, angular_z)\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}], "out": []}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 1289, "y": 90}}, {"id": "e1c6341e-c2f4-4522-a7ad-4b00fc2fedd8", "type": "basic.code", "data": {"code": "import math\nimport numpy as np\nimport rclpy\nimport threading\n\nfrom rclpy.node import Node\nfrom rclpy.qos import (\n    QoSProfile,\n    DurabilityPolicy,\n    qos_profile_sensor_data,\n)\nfrom nav_msgs.msg import Odometry\nfrom sensor_msgs.msg import LaserScan, Image\n\n\nWIDTH = 1500\nHEIGHT = 970\n\n\ndef quaternion_to_yaw(q):\n    numerator = 2.0 * (q.w * q.z + q.x * q.y)\n    denominator = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)\n    return math.atan2(numerator, denominator)\n\n\ndef pose_to_map(world_x, world_y):\n    pixel_y = -23.58 * (-20.36 - world_x)\n    pixel_x = -23.53 * (-31.95 - world_y)\n\n    return round(pixel_x), round(pixel_y)\n\n\ndef bresenham(x0, y0, x1, y1):\n    points = []\n\n    dx = abs(x1 - x0)\n    dy = abs(y1 - y0)\n\n    step_x = 1 if x0 < x1 else -1\n    step_y = 1 if y0 < y1 else -1\n\n    error = dx - dy\n\n    while True:\n        points.append((x0, y0))\n\n        if x0 == x1 and y0 == y1:\n            break\n\n        double_error = 2 * error\n\n        if double_error > -dy:\n            error -= dy\n            x0 += step_x\n\n        if double_error < dx:\n            error += dx\n            y0 += step_y\n\n    return points\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class MapPublisher(Node):\n        def __init__(self):\n            super().__init__(\"vc_ra_map_publisher\")\n\n            self.world_x = 0.0\n            self.world_y = 0.0\n            self.yaw = 0.0\n\n            self.have_odom = False\n            self.scan = None\n\n            self.last_x = None\n            self.last_y = None\n            self.last_yaw = None\n\n            self.log_map = np.zeros(\n                (HEIGHT, WIDTH),\n                dtype=np.float32,\n            )\n            self.image_map = np.full(\n                (HEIGHT, WIDTH),\n                128,\n                dtype=np.uint8,\n            )\n\n            map_qos = QoSProfile(\n                depth=1,\n                durability=DurabilityPolicy.TRANSIENT_LOCAL,\n            )\n\n            self.map_publisher = self.create_publisher(\n                Image,\n                \"/webgui/user_map\",\n                map_qos,\n            )\n\n            self.create_subscription(\n                Odometry,\n                \"/turtlebot3/odom\",\n                self.odom_callback,\n                qos_profile_sensor_data,\n            )\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def odom_callback(self, msg):\n            self.world_x = msg.pose.pose.position.x\n            self.world_y = msg.pose.pose.position.y\n            self.yaw = quaternion_to_yaw(\n                msg.pose.pose.orientation\n            )\n            self.have_odom = True\n\n        def scan_callback(self, msg):\n            self.scan = msg\n            # Check the input wire status inside callback\n            ready_wire = inputs.read_number(\"laser_ready\")\n            if ready_wire is None or float(ready_wire[0]) > 0.5:\n                self.update_map()\n\n        def robot_moved(self):\n            if self.last_x is None:\n                return True\n\n            distance = math.hypot(\n                self.world_x - self.last_x,\n                self.world_y - self.last_y,\n            )\n\n            angle_difference = abs(\n                self.yaw - self.last_yaw\n            )\n            angle_difference = min(\n                angle_difference,\n                2.0 * math.pi - angle_difference,\n            )\n\n            return (\n                distance > 0.05\n                or angle_difference > 0.05\n            )\n\n        def update_map(self):\n            if not self.have_odom or self.scan is None:\n                return\n\n            if not self.robot_moved():\n                return\n\n            self.last_x = self.world_x\n            self.last_y = self.world_y\n            self.last_yaw = self.yaw\n\n            robot_x, robot_y = pose_to_map(\n                self.world_x,\n                self.world_y,\n            )\n\n            for index in range(\n                0,\n                len(self.scan.ranges),\n                3,\n            ):\n                distance = self.scan.ranges[index]\n\n                if not math.isfinite(distance):\n                    continue\n\n                if distance < 0.10 or distance > 10.0:\n                    continue\n\n                laser_angle = (\n                    self.scan.angle_min\n                    + index * self.scan.angle_increment\n                )\n                world_angle = self.yaw + laser_angle\n\n                hit_world_x = (\n                    self.world_x\n                    + distance * math.cos(world_angle)\n                )\n                hit_world_y = (\n                    self.world_y\n                    + distance * math.sin(world_angle)\n                )\n\n                hit_x, hit_y = pose_to_map(\n                    hit_world_x,\n                    hit_world_y,\n                )\n\n                line = bresenham(\n                    robot_x,\n                    robot_y,\n                    hit_x,\n                    hit_y,\n                )\n\n                for cell_x, cell_y in line[:-1]:\n                    if (\n                        0 <= cell_x < WIDTH\n                        and 0 <= cell_y < HEIGHT\n                    ):\n                        self.log_map[\n                            cell_y,\n                            cell_x,\n                        ] -= 0.4\n\n                if (\n                    0 <= hit_x < WIDTH\n                    and 0 <= hit_y < HEIGHT\n                ):\n                    self.log_map[hit_y, hit_x] += 0.9\n\n            np.clip(\n                self.log_map,\n                -5.0,\n                5.0,\n                out=self.log_map,\n            )\n\n            self.image_map.fill(128)\n            self.image_map[self.log_map < -2.0] = 255\n            self.image_map[self.log_map > 2.0] = 0\n\n            self.publish_map()\n\n        def publish_map(self):\n            message = Image()\n\n            message.header.stamp = (\n                self.get_clock().now().to_msg()\n            )\n            message.header.frame_id = \"odom\"\n\n            message.height = HEIGHT\n            message.width = WIDTH\n            message.encoding = \"mono8\"\n            message.is_bigendian = False\n            message.step = WIDTH\n            message.data = self.image_map.tobytes()\n\n            self.map_publisher.publish(message)\n\n    node = MapPublisher()\n\n    # Start spinning the node in a background thread\n    spin_thread = threading.Thread(target=rclpy.spin, args=(node,), daemon=True)\n    spin_thread.start()\n\n    try:\n        while True:\n            synchronise()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        node.destroy_node()", "frequency": "30", "params": [], "ports": {"in": [{"name": "laser_ready"}], "out": []}, "size": {"width": "614px", "height": "300px"}}, "position": {"x": 520, "y": 331}}], "wires": [{"source": {"block": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "port": "state_code", "name": "state_code"}, "target": {"block": "73f90f28-97e4-40dd-be28-673ea9142224", "port": "state_code", "name": "state_code"}}, {"source": {"block": "73f90f28-97e4-40dd-be28-673ea9142224", "port": "linear_x", "name": "linear_x"}, "target": {"block": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "port": "linear_x", "name": "linear_x"}}, {"source": {"block": "73f90f28-97e4-40dd-be28-673ea9142224", "port": "angular_z", "name": "angular_z"}, "target": {"block": "8b2fa44e-3629-47e5-b8b6-a0b61c3052d9", "port": "angular_z", "name": "angular_z"}}, {"source": {"block": "297543fe-9766-4858-95f0-4eca8f39af48", "port": "front_distance", "name": "front_distance"}, "target": {"block": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "port": "front_distance", "name": "front_distance"}}, {"source": {"block": "297543fe-9766-4858-95f0-4eca8f39af48", "port": "laser_ready", "name": "laser_ready"}, "target": {"block": "906f0857-8cc2-4b73-8589-9ccfe98c70f7", "port": "laser_ready", "name": "laser_ready"}}, {"source": {"block": "297543fe-9766-4858-95f0-4eca8f39af48", "port": "laser_ready", "name": "laser_ready"}, "target": {"block": "e1c6341e-c2f4-4522-a7ad-4b00fc2fedd8", "port": "laser_ready", "name": "laser_ready"}}]}}, "dependencies": {}}