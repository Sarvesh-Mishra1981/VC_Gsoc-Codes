 "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "8a706492-a0cc-414a-8603-0e86b994baeb": {"id": "8a706492-a0cc-414a-8603-0e86b994baeb", "type": "default", "selected": true, "source": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "sourcePort": "280a4ebb-e373-4f3d-96ee-72f29817796f", "target": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "targetPort": "e6cedefb-0c9d-45f5-9f8b-568f5f6befc3", "points": [{"id": "d62f0fe7-2e73-4415-9e2c-d15da6c608de", "type": "point", "x": 1450.468727206401, "y": 392.4218849574255}, {"id": "1dbbc1ca-c19a-4773-9cee-2b83e45a596a", "type": "point", "x": 1281.0590652767082, "y": 736.7188388887982}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "4d4f56ee-46b6-40ae-97ec-44f429ccb028", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"773d2b30-e6df-4975-98b5-7d8f9323a6a4": {"id": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "type": "basic.code", "selected": false, "x": 107, "y": 123, "ports": [{"id": "b8b03107-2e1e-4648-b208-72d39e126488", "type": "port.output", "x": 462.55211154400354, "y": 230.36460539847553, "name": "laser_ready", "alignment": "right", "parentNode": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "links": ["ae2bf934-78b5-4731-96ed-00e07c022d1e"], "in": false, "label": "laser_ready", "hideLabel": false}, {"id": "ec4accfb-81b4-4764-9077-83dd6cd87d89", "type": "port.output", "x": 462.55211154400354, "y": 306.7013992191515, "name": "ranges", "alignment": "right", "parentNode": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "links": ["9b5666af-cec9-474e-8d62-8ba84bed393b"], "in": false, "label": "ranges", "hideLabel": false}, {"id": "d060ae80-ab76-4dbc-a7c3-5769a2561b80", "type": "port.output", "x": 462.55211154400354, "y": 371.3628631880641, "name": "angle_min", "alignment": "right", "parentNode": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "links": ["85041eae-18d4-4af6-81f0-d2fbfa69db3e"], "in": false, "label": "angle_min", "hideLabel": false}, {"id": "240c1ab6-df3c-4772-8c71-185e4ff51ee5", "type": "port.output", "x": 462.55211154400354, "y": 436.0330085064343, "name": "angle_increment", "alignment": "right", "parentNode": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "links": ["20ced85f-b6fc-4949-a45b-3d8c9a2e8e6b"], "in": false, "label": "angle_increment", "hideLabel": false}], "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_scan_reader\")\n\n            self.laser_ready = False\n            self.ranges = []\n            self.angle_min = 0.0\n            self.angle_increment = 0.0\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            self.laser_ready = True\n            self.ranges = list(msg.ranges)\n            self.angle_min = msg.angle_min\n            self.angle_increment = msg.angle_increment\n\n    node = LaserBlock()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n\n        outputs.laser_ready = node.laser_ready\n        outputs.ranges = node.ranges\n        outputs.angle_min = node.angle_min\n        outputs.angle_increment = node.angle_increment\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "laser_ready"}, {"name": "ranges"}, {"name": "angle_min"}, {"name": "angle_increment"}]}, "size": {"width": "404px", "height": "318px"}}}, "e587a173-a63c-4360-a0de-21f5c36ae6f0": {"id": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "type": "basic.code", "selected": false, "x": 579, "y": 89, "ports": [{"id": "1a7c1f7e-2eaa-497f-887d-f0733e3a646d", "type": "port.input", "x": 579.5486450195312, "y": 196.3628692626953, "name": "laser_ready", "alignment": "left", "parentNode": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "links": ["ae2bf934-78b5-4731-96ed-00e07c022d1e"], "in": true, "label": "laser_ready", "hideLabel": false}, {"id": "cce16ec5-7780-4408-866a-ddcafbbba1ab", "type": "port.input", "x": 579.5486450195312, "y": 272.6996612548828, "name": "ranges", "alignment": "left", "parentNode": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "links": [], "in": true, "label": "ranges", "hideLabel": false}, {"id": "20848fe9-a94e-4221-b397-3bedcc6da92b", "type": "port.input", "x": 579.5486450195312, "y": 337.3611297607422, "name": "angle_min", "alignment": "left", "parentNode": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "links": ["85041eae-18d4-4af6-81f0-d2fbfa69db3e"], "in": true, "label": "angle_min", "hideLabel": false}, {"id": "8d6d2008-938e-41d7-b29c-e83138ee6f4e", "type": "port.input", "x": 579.5486450195312, "y": 402.03126525878906, "name": "angle_increment", "alignment": "left", "parentNode": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "links": ["20ced85f-b6fc-4949-a45b-3d8c9a2e8e6b"], "in": true, "label": "angle_increment", "hideLabel": false}, {"id": "4a0efd68-6028-4932-b901-e710874f8a5d", "type": "port.output", "x": 984.5486450195312, "y": 299.20140075683594, "name": "front_distance", "alignment": "right", "parentNode": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "links": ["0c5ba9ad-8c86-404e-a8be-710664c7cc1b"], "in": false, "label": "front_distance", "hideLabel": false}], "data": {"code": "import math\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    front_width = 0.35\n\n    while True:\n        laser_ready = getattr(inputs, \"laser_ready\", False)\n        ranges = getattr(inputs, \"ranges\", [])\n        angle_min = getattr(inputs, \"angle_min\", 0.0)\n        angle_increment = getattr(inputs, \"angle_increment\", 0.0)\n\n        front_distance = 10.0\n\n        if laser_ready and ranges:\n            values = []\n\n            for i, dist in enumerate(ranges):\n                angle = angle_min + i * angle_increment\n\n                if -front_width <= angle <= front_width:\n                    if math.isfinite(dist) and dist > 0.05:\n                        values.append(dist)\n\n            if values:\n                front_distance = min(values)\n\n        outputs.front_distance = front_distance\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "laser_ready"}, {"name": "ranges"}, {"name": "angle_min"}, {"name": "angle_increment"}], "out": [{"name": "front_distance"}]}, "size": {"width": "404px", "height": "318px"}}}, "5bf9d62c-bad8-4b33-8729-d49b69e9f749": {"id": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "type": "basic.code", "selected": false, "x": 1040.332906224805, "y": 82.22059631087554, "ports": [{"id": "a1afcf3d-891a-4be0-a376-42bae52bd758", "type": "port.input", "x": 1040.8855262633, "y": 292.4219056787101, "name": "front_distance", "alignment": "left", "parentNode": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "links": ["0c5ba9ad-8c86-404e-a8be-710664c7cc1b"], "in": true, "label": "front_distance", "hideLabel": false}, {"id": "8d95b860-e5bd-44d3-91c2-c879b9dffc93", "type": "port.output", "x": 1442.9687374032253, "y": 211.58856470547616, "name": "linear_x", "alignment": "right", "parentNode": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "links": ["be0034b5-cb8c-4faf-9ec0-d15b489b4a44"], "in": false, "label": "linear_x", "hideLabel": false}, {"id": "a1c34f71-8da7-4b9c-8c54-501763e50922", "type": "port.output", "x": 1442.9687374032253, "y": 298.2551997862885, "name": "angular_z", "alignment": "right", "parentNode": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "links": ["f9aca15e-eaec-4659-a1a9-b89e7580e314"], "in": false, "label": "angular_z", "hideLabel": false}, {"id": "280a4ebb-e373-4f3d-96ee-72f29817796f", "type": "port.output", "x": 1442.9687374032253, "y": 384.92189515424985, "name": "state", "alignment": "right", "parentNode": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "links": ["2a1dbf59-f905-40a1-9e23-9a910366f62c", "4271574f-2d7f-4027-9451-3d3e8378ff9f", "8a706492-a0cc-414a-8603-0e86b994baeb"], "in": false, "label": "state", "hideLabel": false}], "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    state = \"FORWARD\"\n\n    forward_speed = 0.16\n    turn_speed = 0.45\n\n    front_stop_distance = 0.60\n    front_clear_distance = 0.90\n\n    while True:\n        front_distance = getattr(inputs, \"front_distance\", 10.0)\n\n        if front_distance is None:\n            front_distance = 10.0\n\n        linear_x = 0.0\n        angular_z = 0.0\n\n        if state == \"FORWARD\":\n            if front_distance < front_stop_distance:\n                state = \"TURN_LEFT\"\n                linear_x = 0.0\n                angular_z = turn_speed\n            else:\n                linear_x = forward_speed\n                angular_z = 0.0\n\n        elif state == \"TURN_LEFT\":\n            linear_x = 0.0\n            angular_z = turn_speed\n\n            if front_distance > front_clear_distance:\n                state = \"FORWARD\"\n                linear_x = forward_speed\n                angular_z = 0.0\n\n        outputs.linear_x = linear_x\n        outputs.angular_z = angular_z\n        outputs.state = state\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}, {"name": "state"}]}, "size": {"width": "404px", "height": "318px"}}}, "e66d982e-1be5-4d63-aca8-55f5c4db3f89": {"id": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "type": "basic.code", "selected": true, "x": 1272.4528988328188, "y": 425.9557343006151, "ports": [{"id": "9371cfb1-f5a4-4677-9ea5-55bd6ab14a0d", "type": "port.input", "x": 1273.5590754735326, "y": 555.8853980625511, "name": "linear_x", "alignment": "left", "parentNode": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "links": ["be0034b5-cb8c-4faf-9ec0-d15b489b4a44"], "in": true, "label": "linear_x", "hideLabel": false}, {"id": "01c11fc7-2f65-4b13-b9c5-48fa6c4b3ee0", "type": "port.input", "x": 1273.5590754735326, "y": 642.5521537176612, "name": "angular_z", "alignment": "left", "parentNode": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "links": ["f9aca15e-eaec-4659-a1a9-b89e7580e314"], "in": true, "label": "angular_z", "hideLabel": false}, {"id": "e6cedefb-0c9d-45f5-9f8b-568f5f6befc3", "type": "port.input", "x": 1273.5590754735326, "y": 729.2188490856227, "name": "state", "alignment": "left", "parentNode": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "links": ["8a706492-a0cc-414a-8603-0e86b994baeb"], "in": true, "label": "state", "hideLabel": false}], "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class CmdVelBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_cmd_vel_publisher\")\n            self.pub = self.create_publisher(Twist, \"/turtlebot3/cmd_vel\", 10)\n\n        def publish_cmd(self, linear_x, angular_z):\n            msg = Twist()\n            msg.linear.x = float(linear_x)\n            msg.angular.z = float(angular_z)\n            self.pub.publish(msg)\n\n    node = CmdVelBlock()\n\n    while True:\n        linear_x = getattr(inputs, \"linear_x\", 0.0)\n        angular_z = getattr(inputs, \"angular_z\", 0.0)\n\n        if linear_x is None:\n            linear_x = 0.0\n\n        if angular_z is None:\n            angular_z = 0.0\n\n        node.publish_cmd(linear_x, angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}, {"name": "state"}], "out": []}, "size": {"width": "404px", "height": "318px"}}}}}]}, "version": "3.0", "package": {"name": "", "version": "", "description": "", "author": "", "image": ""}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "type": "basic.code", "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom rclpy.qos import qos_profile_sensor_data\nfrom sensor_msgs.msg import LaserScan\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class LaserBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_laser_scan_reader\")\n\n            self.laser_ready = False\n            self.ranges = []\n            self.angle_min = 0.0\n            self.angle_increment = 0.0\n\n            self.create_subscription(\n                LaserScan,\n                \"/turtlebot3/laser/scan\",\n                self.scan_callback,\n                qos_profile_sensor_data,\n            )\n\n        def scan_callback(self, msg):\n            self.laser_ready = True\n            self.ranges = list(msg.ranges)\n            self.angle_min = msg.angle_min\n            self.angle_increment = msg.angle_increment\n\n    node = LaserBlock()\n\n    while True:\n        rclpy.spin_once(node, timeout_sec=0.0)\n\n        outputs.laser_ready = node.laser_ready\n        outputs.ranges = node.ranges\n        outputs.angle_min = node.angle_min\n        outputs.angle_increment = node.angle_increment\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [], "out": [{"name": "laser_ready"}, {"name": "ranges"}, {"name": "angle_min"}, {"name": "angle_increment"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 107, "y": 123}}, {"id": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "type": "basic.code", "data": {"code": "import math\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    front_width = 0.35\n\n    while True:\n        laser_ready = getattr(inputs, \"laser_ready\", False)\n        ranges = getattr(inputs, \"ranges\", [])\n        angle_min = getattr(inputs, \"angle_min\", 0.0)\n        angle_increment = getattr(inputs, \"angle_increment\", 0.0)\n\n        front_distance = 10.0\n\n        if laser_ready and ranges:\n            values = []\n\n            for i, dist in enumerate(ranges):\n                angle = angle_min + i * angle_increment\n\n                if -front_width <= angle <= front_width:\n                    if math.isfinite(dist) and dist > 0.05:\n                        values.append(dist)\n\n            if values:\n                front_distance = min(values)\n\n        outputs.front_distance = front_distance\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "laser_ready"}, {"name": "ranges"}, {"name": "angle_min"}, {"name": "angle_increment"}], "out": [{"name": "front_distance"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 579, "y": 89}}, {"id": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "type": "basic.code", "data": {"code": "def main(inputs, outputs, parameters, synchronise):\n    state = \"FORWARD\"\n\n    forward_speed = 0.16\n    turn_speed = 0.45\n\n    front_stop_distance = 0.60\n    front_clear_distance = 0.90\n\n    while True:\n        front_distance = getattr(inputs, \"front_distance\", 10.0)\n\n        if front_distance is None:\n            front_distance = 10.0\n\n        linear_x = 0.0\n        angular_z = 0.0\n\n        if state == \"FORWARD\":\n            if front_distance < front_stop_distance:\n                state = \"TURN_LEFT\"\n                linear_x = 0.0\n                angular_z = turn_speed\n            else:\n                linear_x = forward_speed\n                angular_z = 0.0\n\n        elif state == \"TURN_LEFT\":\n            linear_x = 0.0\n            angular_z = turn_speed\n\n            if front_distance > front_clear_distance:\n                state = \"FORWARD\"\n                linear_x = forward_speed\n                angular_z = 0.0\n\n        outputs.linear_x = linear_x\n        outputs.angular_z = angular_z\n        outputs.state = state\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "front_distance"}], "out": [{"name": "linear_x"}, {"name": "angular_z"}, {"name": "state"}]}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 1040.332906224805, "y": 82.22059631087554}}, {"id": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "type": "basic.code", "data": {"code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Twist\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    if not rclpy.ok():\n        rclpy.init(args=None)\n\n    class CmdVelBlock(Node):\n        def __init__(self):\n            super().__init__(\"vc_cmd_vel_publisher\")\n            self.pub = self.create_publisher(Twist, \"/turtlebot3/cmd_vel\", 10)\n\n        def publish_cmd(self, linear_x, angular_z):\n            msg = Twist()\n            msg.linear.x = float(linear_x)\n            msg.angular.z = float(angular_z)\n            self.pub.publish(msg)\n\n    node = CmdVelBlock()\n\n    while True:\n        linear_x = getattr(inputs, \"linear_x\", 0.0)\n        angular_z = getattr(inputs, \"angular_z\", 0.0)\n\n        if linear_x is None:\n            linear_x = 0.0\n\n        if angular_z is None:\n            angular_z = 0.0\n\n        node.publish_cmd(linear_x, angular_z)\n\n        synchronise()", "frequency": "30", "params": [], "ports": {"in": [{"name": "linear_x"}, {"name": "angular_z"}, {"name": "state"}], "out": []}, "size": {"width": "404px", "height": "318px"}}, "position": {"x": 1272.4528988328188, "y": 425.9557343006151}}], "wires": [{"source": {"block": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "port": "laser_ready", "name": "laser_ready"}, "target": {"block": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "port": "laser_ready", "name": "laser_ready"}}, {"source": {"block": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "port": "angle_min", "name": "angle_min"}, "target": {"block": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "port": "angle_min", "name": "angle_min"}}, {"source": {"block": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "port": "angle_increment", "name": "angle_increment"}, "target": {"block": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "port": "angle_increment", "name": "angle_increment"}}, {"source": {"block": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "port": "front_distance", "name": "front_distance"}, "target": {"block": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "port": "front_distance", "name": "front_distance"}}, {"source": {"block": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "port": "linear_x", "name": "linear_x"}, "target": {"block": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "port": "linear_x", "name": "linear_x"}}, {"source": {"block": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "port": "angular_z", "name": "angular_z"}, "target": {"block": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "port": "angular_z", "name": "angular_z"}}, {"source": {"block": "5bf9d62c-bad8-4b33-8729-d49b69e9f749", "port": "state", "name": "state"}, "target": {"block": "e66d982e-1be5-4d63-aca8-55f5c4db3f89", "port": "state", "name": "state"}}]}}, "dependencies": {}}