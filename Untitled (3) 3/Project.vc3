{"editor": {"id": "7f97d8e9-a27f-43c8-9968-4e50b6f8c3e1", "offsetX": -7.5312964958074815, "offsetY": -7.332864113547922, "zoom": 101.24074077360915, "gridSize": 0, "layers": [{"id": "6db3cee5-22a2-4ea8-b737-a68af582250d", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"ae2bf934-78b5-4731-96ed-00e07c022d1e": {"id": "ae2bf934-78b5-4731-96ed-00e07c022d1e", "type": "default", "selected": false, "source": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "sourcePort": "b8b03107-2e1e-4648-b208-72d39e126488", "target": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "targetPort": "1a7c1f7e-2eaa-497f-887d-f0733e3a646d", "points": [{"id": "ce288959-bda2-491f-828a-238002f46398", "type": "point", "x": 470.0521178319465, "y": 237.86459520165118}, {"id": "bf6fefa8-a29a-4d1d-8082-9734a64b01e3", "type": "point", "x": 587.0486454963684, "y": 203.86286973953247}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "9b5666af-cec9-474e-8d62-8ba84bed393b": {"id": "9b5666af-cec9-474e-8d62-8ba84bed393b", "type": "default", "selected": false, "source": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "sourcePort": "ec4accfb-81b4-4764-9077-83dd6cd87d89", "target": null, "targetPort": null, "points": [{"id": "7e6878f3-57ab-43ce-8025-247d9ec8ac8d", "type": "point", "x": 470.0521178319465, "y": 314.2014055070945}, {"id": "e8e8e612-51a6-4cd5-8392-dc35854cbf49", "type": "point", "x": 585, "y": 285.00694274902344}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "85041eae-18d4-4af6-81f0-d2fbfa69db3e": {"id": "85041eae-18d4-4af6-81f0-d2fbfa69db3e", "type": "default", "selected": false, "source": "773d2b30-e6df-4975-98b5-7d8f9323a6a4", "sourcePort": "d060ae80-ab76-4dbc-a7c3-5769a2561b80", "target": "e587a173-a63c-4360-a0de-21f5c36ae6f0", "targetPort": "20848fe9-a94e-4221-b397-3bedcc6da92b", "points": [{"id": "7813b1df-022c-4125-8b0c-8dbf29e50e0d", "type": "point", "x": 470.0521178319465, "y": 378.8628694760